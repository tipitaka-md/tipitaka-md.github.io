function groupContainsBook(group: NavGroup, bookCode: string): boolean {
  if (!bookCode) return false;
  if (group.books?.some((b) => b.code === bookCode)) return true;
  if (group.children?.some((c) => groupContainsBook(c, bookCode))) return true;
  return false;
}

const INDEX_LINKS = [
  { code: 'guide', title: 'Quick Guide', href: '/guide.html' },
  { code: 'about', title: 'About This Website', href: '/about.html' },
  { code: 'project', title: 'World Tipiṭaka Project', href: '/project.html' },
  { code: 'toc', title: 'Table of Contents', href: '/toc.html' },
  { code: 'verses', title: 'Index of Verses (Gāthā)', href: '/verses.html' },
  { code: 'notes', title: 'Critical Apparatus Notes', href: '/notes.html' },
  { code: 'concordances', title: 'Page Concordances', href: '/concordances.html' },
  { code: 'words', title: 'Pāḷi Word Index', href: '/words.html' },
];
const isIndexPage = INDEX_LINKS.some((item) => item.code === currentBook);
---

<aside class="sidebar" aria-label="Tipiṭaka Navigation">
  <a href="/" class="sidebar-brand">
    <img src="/images/logo48.png" alt="Tipitaka Multi-Edition" id="logo" width="24" height="24" />
    <span class="sidebar-brand-text">tipitaka-md.github.io</span>
  </a>

  <button
    type="button"
    class="quick-jump-trigger"
    id="open-quick-jump"
    aria-label="Quick jump to book or paragraph citation (Command+K)"
  >
    <span class="quick-jump-trigger-label">Jump to book or ref (e.g. 18Dh:1)</span>
    <kbd class="quick-jump-kbd">⌘K</kbd>
  </button>

  <div class="sidebar-dict-toggle-wrap">
    <button
      type="button"
      id="dict-toggle-sidebar"
      class="sidebar-dict-toggle-btn active"
      aria-pressed="true"
      title="Toggle Dictionary Lookup"
    >
      <span class="sidebar-dict-label">📖 Dictionary Lookup</span>
      <span class="sidebar-dict-status" id="sidebar-dict-status">ON</span>
    </button>
  </div>

  <div class="sidebar-dict-toggle-wrap pwa-install-wrap" style="display: none;">
    <button
      type="button"
      class="sidebar-dict-toggle-btn pwa-install-btn"
      aria-label="Install Tipiṭaka App"
      title="Install Tipiṭaka 2500 App for offline reading"
    >
      <span class="sidebar-dict-label">📥 Install App (PWA)</span>
      <span class="sidebar-dict-status" style="background-color: var(--primary-color); color: #fff;">PWA</span>
    </button>
  </div>

  <ul class="sidebar-list">
    <li class="sidebar-item">
      <details open={isIndexPage || !currentBook}>
        <summary class="btn-toggle">Indices &amp; Reference</summary>
        <ul class="btn-toggle-nav">
          {
            INDEX_LINKS.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['sidebar-link', { active: currentBook === item.code }]}
                  aria-current={currentBook === item.code ? 'page' : undefined}
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </li>
    <li class="sidebar-divider" role="separator"></li>
    {
      NAV_TREE.map((pitaka, idx) => (
        <>
          {idx > 0 && <li class="sidebar-divider" role="separator" />}
          <li class="sidebar-item">
            <details open={groupContainsBook(pitaka, currentBook)}>
              <summary class="btn-toggle">{pitaka.label}</summary>
              <ul class="btn-toggle-nav">
                {pitaka.books?.map((book) => (
                  <li>
                    <a
                      href={book.href}
                      class:list={['sidebar-link', { active: currentBook === book.code }]}
                      aria-current={currentBook === book.code ? 'page' : undefined}
                    >
                      {book.title}
                    </a>
                  </li>
                ))}
                {pitaka.children?.map((subGroup) => (
                  <li class="sidebar-subitem">
                    <details open={groupContainsBook(subGroup, currentBook)}>
                      <summary class="btn-toggle">{subGroup.label}</summary>
                      <ul class="btn-toggle-nav">
                        {subGroup.books?.map((book) => (
                          <li>
                            <a
                              href={book.href}
                              class:list={['sidebar-link', { active: currentBook === book.code }]}
                              aria-current={currentBook === book.code ? 'page' : undefined}
                            >
                              {book.title}
                            </a>
                          </li>
                        ))}
                        {subGroup.children?.map((leafGroup) => (
                          <li class="sidebar-subitem">
                            <details open={groupContainsBook(leafGroup, currentBook)}>
                              <summary class="btn-toggle">{leafGroup.label}</summary>
                              <ul class="btn-toggle-nav">
                                {leafGroup.books?.map((book) => (
                                  <li>
                                    <a
                                      href={book.href}
                                      class:list={[
                                        'sidebar-link',
                                        { active: currentBook === book.code },
                                      ]}
                                      aria-current={currentBook === book.code ? 'page' : undefined}
                                    >
                                      {book.title}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </details>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        </>
      ))
    }
  </ul>
</aside>
