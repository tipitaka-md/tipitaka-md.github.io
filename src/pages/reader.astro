  function normalizeBookCode(code: string): string {
    if (!code) return '1V';
    const clean = code.trim().toLowerCase();
    return BOOK_CODE_ALIASES[clean] || code;
  }

  function getBookInfo(bookCode: string) {
    const normalized = normalizeBookCode(bookCode);
    if (BOOK_MAP[normalized]) return BOOK_MAP[normalized];
    if (BOOK_MAP[bookCode]) return BOOK_MAP[bookCode];
    if (catalog) {
      for (const p of catalog.structure) {
        for (const b of p.books) {
          if (b.code.toLowerCase() === normalized.toLowerCase() || b.code.toLowerCase() === bookCode.toLowerCase()) {
            return { title: b.title, pitaka: p.title };
          }
        }
      }
    }
    return { title: bookCode, pitaka: '' };
  }

  function extractTitleFromMarkdown(markdown: string): string {
    const match = (markdown || '').match(/^\s*#\s+([^\n]+)/m);
    if (match) {
      return match[1].replace(/[#*_`]/g, '').trim();
    }
    return '';
  }


