  /**
   * Helper to trigger direct browser download of Markdown text
   */
  function downloadMarkdownFile(filename: string, text: string) {
    const cleanFilename = filename.endsWith('.md') ? filename : `${filename}.md`;
    const blob = new Blob([text], { type: 'text/markdown;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = cleanFilename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function cleanMarkdownText(str: string): string {
    if (!str) return '';
    return str
      .replace(/\[\^[^\]]+\]/g, '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/[*_#`]/g, ' ')
      .replace(/[\x27\`\"\u2018\u2019\u201c\u201d]/g, '');
  }

  function normalizePaliForSearch(str: string): string {
    return cleanMarkdownText(str)
      .toLowerCase()
      .replace(/[ṁṃ]/g, 'ṃ')
      .replace(/[^a-zāīūñṅṇḍṭḷṃ\s]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function paliStem(w: string): string {
    if (!w || w.length <= 3) return w || '';
    return w.replace(/[oaeuāīūi][ṃṁ]?$|[ṃṁ]$/, '');
  }

  function wordsMatch(w1: string, w2: string): boolean {
    if (w1 === w2) return true;
    if (w1.length >= 4 && w2.length >= 4) {
      const s1 = paliStem(w1);
      const s2 = paliStem(w2);
      if (s1 === s2 || (s1.length >= 4 && (s2.startsWith(s1) || s1.startsWith(s2)))) {
        return true;
      }
    }
    return false;
  }

  function containsWordSequence(lineNorm: string, targetWords: string[], threshold: number = 0.6): boolean {
    if (!lineNorm || targetWords.length === 0) return false;
    const lineWords = lineNorm.split(' ').filter(w => w.length > 2);
    let matches = 0;
    for (const tw of targetWords) {
      if (lineWords.some(lw => wordsMatch(tw, lw))) {
        matches++;
      }
    }
    return (matches / targetWords.length) >= threshold;
  }

  interface ElisionResult {
    content: string;
    isElided: boolean;
    hasEarlier: boolean;
    hasSubsequent: boolean;
  }

  interface ExtractedFootnotes {
    body: string;
    definitions: Map<string, string>;
  }

  /**
   * Extract footnote definitions from ## Footnotes section, inline definitions,
   * and page-level note lines (e.g. Siam Rath #[^...]) across all editions.
   */
  function extractFootnotes(md: string): ExtractedFootnotes {
    const definitions = new Map<string, string>();
    let body = md || '';
    let fnSection = '';

    const fnHeadingMatch = body.match(/^##\s+Footnotes\s*$/m);
    if (fnHeadingMatch && fnHeadingMatch.index !== undefined) {
      fnSection = body.slice(fnHeadingMatch.index);
      body = body.slice(0, fnHeadingMatch.index);
    }

    function addDef(rawId: string, rawText: string) {
      const id = rawId.trim();
      const text = rawText.trim().replace(/\s+/g, ' ');
      if (!id || !text) return;
      if (!definitions.has(id)) definitions.set(id, text);
      if (id.startsWith('p') && id.includes('-')) {
        const noP = id.slice(1);
        if (!definitions.has(noP)) definitions.set(noP, text);
      } else if (!id.startsWith('p')) {
        const withP = 'p' + id;
        if (!definitions.has(withP)) definitions.set(withP, text);
      }
    }

    // 1. Parse definitions from ## Footnotes section
    if (fnSection) {
      const lines = fnSection.split('\n');
      let curId: string | null = null;
      let curBuf: string[] = [];

      for (const line of lines) {
        const defMatch = line.match(/^\s*\[\^([^\]]+)\]:\s*(.*)$/);
        if (defMatch) {
          if (curId) addDef(curId, curBuf.join(' '));
          curId = defMatch[1];
          curBuf = [defMatch[2]];
        } else if (curId && line.trim() && !line.startsWith('#') && !line.startsWith('<')) {
          curBuf.push(line.trim());
        } else if (line.trim().startsWith('#') || line.trim() === '---' || line.trim().startsWith('<')) {
          if (curId) {
            addDef(curId, curBuf.join(' '));
            curId = null;
            curBuf = [];
          }
        }
      }
      if (curId) addDef(curId, curBuf.join(' '));
    }

    // 2. Parse inline #+...[^ lines (e.g. Siam Rath #[^2-1] ...)
    body = body.replace(/^\s*#+.*\[\^.*$/gm, (line) => {
      const itemRegex = /\[\^([^\]]+)\]\s*([^\[]+)/g;
      let m: RegExpExecArray | null;
      while ((m = itemRegex.exec(line)) !== null) {
        addDef(m[1], m[2]);
      }
      return '';
    });

    // 3. Parse any standalone [^id]: definitions in body
    body = body.replace(/^\s*\[\^([^\]]+)\]:\s*(.*)$/gm, (_, id, text) => {
      addDef(id, text);
      return '';
    });

    return { body: body.trim(), definitions };
  }

  /**
   * Elide non-relevant sections from other editions to match the specific section in tipitaka2500
   */
  function elideOtherEdition(baseMd: string, otherMd: string, sectionTitle: string, paneId: string): ElisionResult {
    const baseLines = (baseMd || '').split('\n')
      .map(l => l.trim())
      .filter(l => l && !l.startsWith('[') && !l.startsWith('*') && !l.startsWith('#') && !l.startsWith('<!--'));

    const firstPara = baseLines.find(l => normalizePaliForSearch(l).length > 20) || baseLines[0];
    const lastPara = [...baseLines].reverse().find(l => normalizePaliForSearch(l).length > 10) || baseLines[baseLines.length - 1];

    if (!firstPara || !lastPara) {
      return { content: otherMd, isElided: false, hasEarlier: false, hasSubsequent: false };
    }

    const normFirst = normalizePaliForSearch(firstPara);
    const normLast = normalizePaliForSearch(lastPara);

    const firstWords = normFirst.split(' ').filter(w => w.length > 2).slice(0, 5);
    const lastWords = normLast.split(' ').filter(w => w.length > 2);
    const substantiveLines = baseLines.filter(l => normalizePaliForSearch(l).length > 25);
    const penultimatePara = substantiveLines[substantiveLines.length - 1] || lastPara;
    const penultimateWords = normalizePaliForSearch(penultimatePara).split(' ').filter(w => w.length > 2).slice(-6);

    const otherLines = (otherMd || '').split('\n');
    let startLine = -1;
    let endLine = -1;

    for (let i = 0; i < otherLines.length; i++) {
      const norm = normalizePaliForSearch(otherLines[i]);
      if (norm && containsWordSequence(norm, firstWords, 0.6)) {
        startLine = i;
        break;
      }
    }

    if (startLine !== -1) {
      for (let i = startLine; i < otherLines.length; i++) {
        const norm = normalizePaliForSearch(otherLines[i]);
        if (norm && containsWordSequence(norm, lastWords, 0.6)) {
          endLine = i;
          break;
        }
      }
      if (endLine === -1) {
        for (let i = startLine; i < otherLines.length; i++) {
          const norm = normalizePaliForSearch(otherLines[i]);
          if (norm && containsWordSequence(norm, penultimateWords, 0.6)) {
            endLine = i;
            break;
          }
        }
      }
    }

    if (startLine === -1 || endLine === -1) {
      return { content: otherMd, isElided: false, hasEarlier: false, hasSubsequent: false };
    }

    // Check preceding lines for section heading or chapter title
    let headingLine = startLine;
    for (let k = startLine - 1; k >= Math.max(0, startLine - 4); k--) {
      const line = otherLines[k].trim();
      if (line.startsWith('#') || (line.startsWith('<p align="center">') && line.includes('kathā'))) {
        headingLine = k;
        break;
      }
      if (line !== '' && !line.startsWith('<!--') && !line.startsWith('<a id=')) {
        break;
      }
    }

    const hasEarlier = headingLine > 2;
    const hasSubsequent = endLine < otherLines.length - 3;

    if (!hasEarlier && !hasSubsequent) {
      return { content: otherMd, isElided: false, hasEarlier: false, hasSubsequent: false };
    }

    // Check if line after endLine has concluding marker
    let finalEndLine = endLine;
    if (endLine + 1 < otherLines.length) {
      const nextLine = otherLines[endLine + 1].trim();
      if (nextLine.includes('niṭṭhit') || nextLine.includes('samatt')) {
        finalEndLine = endLine + 1;
      }
    }

    const titleDisplay = sectionTitle ? escapeHtml(sectionTitle) : 'current section';
    const elidedLines: string[] = [];

    if (hasEarlier) {
      elidedLines.push(
        `<div class="elision-notice elision-top">` +
        `<span>‹ Earlier sections elided (displaying text matching <strong>${titleDisplay}</strong>)</span>` +
        `<button type="button" class="btn-toggle-elision" data-pane="${paneId}">Show complete file</button>` +
        `</div>\n`
      );
    }

    const sliceArray = otherLines.slice(headingLine, finalEndLine + 1);
    if (sliceArray.length > 0) {
      const last = sliceArray[sliceArray.length - 1];
      const matchConclusion = last.match(/^(.*?(?:niṭṭhit[a-zāīūṃṁ]*|samatt[a-zāīūṃṁ]*)\.?)(?:\s+[A-Za-zāīūñṅṇḍṭḷṃ].*|$)/i);
      if (matchConclusion && matchConclusion[1].trim().length > 0) {
        sliceArray[sliceArray.length - 1] = matchConclusion[1].trim();
      }
    }
    const slicedSection = sliceArray.join('\n');
    elidedLines.push(slicedSection);

    // Extract footnote definitions from the full source markdown
    const { definitions } = extractFootnotes(otherMd);
    const sliceRefs = new Set<string>();
    const calloutRegex = /\[\^([^\]]+)\]/g;
    let cm: RegExpExecArray | null;
    while ((cm = calloutRegex.exec(slicedSection)) !== null) {
      sliceRefs.add(cm[1]);
    }

    if (hasSubsequent) {
      elidedLines.push(
        `\n<div class="elision-notice elision-bottom">` +
        `<span>‹ Subsequent sections elided</span>` +
        `<button type="button" class="btn-toggle-elision" data-pane="${paneId}">Show complete file</button>` +
        `</div>`
      );
    }

    if (sliceRefs.size > 0 && definitions.size > 0) {
      const relevantDefs: Array<[string, string]> = [];
      const seen = new Set<string>();
      for (const ref of sliceRefs) {
        const norm = ref.startsWith('p') && ref.includes('-') ? ref.slice(1) : ref;
        const text = definitions.get(ref) || definitions.get(norm) || definitions.get('p' + ref);
        if (text && !seen.has(norm)) {
          seen.add(norm);
          relevantDefs.push([ref, text]);
        }
      }
      if (relevantDefs.length > 0) {
        elidedLines.push('\n\n---\n\n## Footnotes\n');
        for (const [fid, ftext] of relevantDefs) {
          elidedLines.push(`[^${fid}]: ${ftext}`);
        }
      }
    }

    return {
      content: elidedLines.join('\n'),
      isElided: true,
      hasEarlier,
      hasSubsequent,
    };
  }

  /**
   * Resolves relative markdown links into clean reader navigation URLs
   */
  function resolveMarkdownLink(href: string, fromFile: string, edition: string): string {
    if (href.startsWith('http://') || href.startsWith('https://') || href.startsWith('#') || href.startsWith('mailto:')) {
      return href;
    }
    if (href === '/') {
      return '/';
    }

    const [pathPart, hashPart] = href.split('#');
    const hashSuffix = hashPart ? `#${hashPart}` : '';
    const cleanHref = pathPart.replace(/^\//, '');
    const parts = (fromFile || 'tipitaka/index.md').split('/');
    parts.pop(); // remove current file name, keep directory

    const hrefParts = cleanHref.split('/');
    for (const part of hrefParts) {
      if (part === '.' || part === '') continue;
      if (part === '..') {
        if (parts.length > 0) parts.pop();
      } else {
        parts.push(part);
      }
    }
    const resolved = parts.join('/');
    return `/reader.html?edition=${encodeURIComponent(edition)}&file=${encodeURIComponent(resolved)}${hashSuffix}`;
  }

  /**
   * Custom marked renderer that transforms all Markdown links to reader routes
   * and preserves paragraph anchors for WTK volume & paragraph numbering
   */
  function createMarkedRenderer(fromFile: string, edition: string) {
    const renderer = new marked.Renderer();
    renderer.link = function (token: any) {
      const href = token.href || '';
      const text = this.parser.parseInline(token.tokens || []) || token.text || '';
      const title = token.title || '';
      const targetUrl = resolveMarkdownLink(href, fromFile, edition);
      const isExternal = targetUrl.startsWith('http://') || targetUrl.startsWith('https://');
      const targetAttr = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
      const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
      return `<a href="${targetUrl}"${targetAttr}${titleAttr} data-reader-link="true">${text}</a>`;
    };

    renderer.list = function (token: any) {
      if (token.ordered && typeof token.start === 'number' && token.start > 0) {
        const start = token.start;
        const body = token.items.map((item: any, idx: number) => {
          const parNum = start + idx;
          const parsedItem = this.listitem(item);
          return parsedItem.replace(/^<li([^>]*)>/, `<li$1 id="p${parNum}" class="wtk-par-item" data-par="${parNum}">`);
        }).join('\n');
        return `<ol start="${start}" class="wtk-par-list">\n${body}\n</ol>\n`;
      }
      const ordered = token.ordered;
      const start = token.start;
      const tag = ordered ? 'ol' : 'ul';
      const startAttr = ordered && start !== 1 ? ` start="${start}"` : '';
      const body = token.items.map((item: any) => this.listitem(item)).join('\n');
      return `<${tag}${startAttr}>\n${body}\n</${tag}>\n`;
    };

    renderer.paragraph = function (token: any) {
      const inlineHtml = this.parser.parseInline(token.tokens || []);
      const match = inlineHtml.match(/^(\d+)\.\s+/);
      if (match) {
        const parNum = match[1];
        const rest = inlineHtml.slice(match[0].length);
        return `<p id="p${parNum}" class="wtk-paragraph" data-par="${parNum}"><span class="wtk-par-num" id="par-${parNum}">${parNum}.</span> ${rest}</p>\n`;
      }
      return `<p>${inlineHtml}</p>\n`;
    };

    return renderer;
  }

  /**
   * Detect sutta ID from a markdown file path using catalog mapping
   */
  function detectSuttaFromPath(filePath: string): string {
    if (!catalog || !filePath) return '';
    const clean = filePath.replace(/^\/+/, '');
    for (const pitaka of catalog.structure) {
      for (const book of pitaka.books) {
        if (book.suttas) {
          for (const s of book.suttas) {
            for (const ed in s.editions) {
              const edPath = s.editions[ed].replace(/^\/+/, '');
              if (
                clean === edPath ||
                clean.startsWith(edPath.replace(/\.md$/, '/')) ||
                clean.replace(/\.md$/, '') === edPath.replace(/\.md$/, '')
              ) {
                return s.id;
              }
            }
          }
        }
      }
    }
    return '';
  }

  /**
   * Fetch markdown content dynamically from GitHub raw or jsDelivr CDN
   */
  async function fetchMarkdown(edition: string, filePath: string): Promise<string> {
    const cleanPath = (filePath || '').replace(/^\/+/, '').replace(/\.html$/, '.md');
    const cacheKey = `${edition}:${cleanPath}`;
    if (contentCache.has(cacheKey)) {
      return contentCache.get(cacheKey)!;
    }

    const edConfig = catalog?.editions[edition];
    let repo = edConfig ? edConfig.repo : 'tipitaka-md/tipitaka2500';
    let branch = edConfig ? edConfig.branch : 'main';

    // Canonical directory / menu files under tipitaka/ are hosted centrally in tipitaka2500
    if (cleanPath.startsWith('tipitaka/') && edition !== 'tipitaka2500') {
      repo = 'tipitaka-md/tipitaka2500';
      branch = 'main';
    }
    const repoShort = repo.replace(/^tipitaka-md\//, '');

    // 1. Fetch dynamically from GitHub raw
    try {
      const rawUrl = `https://raw.githubusercontent.com/${repo}/${branch}/${cleanPath}`;
      const res = await fetch(rawUrl, { cache: 'no-store' });
      if (res.ok) {
        const text = await res.text();
        if (text && !text.includes('<!DOCTYPE html>')) {
          contentCache.set(cacheKey, text);
          return text;
        }
      }
    } catch {
      // Fallback
    }

    // 2. Fallback dynamically to jsDelivr CDN
    try {
      const cdnUrl = `https://cdn.jsdelivr.net/gh/tipitaka-md/${repoShort}@${branch}/${cleanPath}`;
      const res = await fetch(cdnUrl, { cache: 'no-store' });
      if (res.ok) {
        const text = await res.text();
        if (text && !text.includes('<!DOCTYPE html>')) {
          contentCache.set(cacheKey, text);
          return text;
        }
      }
      throw new Error(`HTTP ${res.status}: ${res.statusText}`);
    } catch (err) {
      console.warn(`Failed to fetch ${cleanPath} for ${edition}:`, err);
      return `# Not Found\n\nCould not load \`${cleanPath}\` from \`${repo}\`.`;
    }
  }

  /**
   * Omit PTS paragraph numbers and page numbers dynamically for display
   * so that text flows smoothly and reads naturally, while leaving the genuine
   * raw Markdown intact for raw view and downloads.
   */
  function cleanPtsForDisplay(md: string): string {
    if (!md) return '';
    let body = md;
    let footer = '';

    if (body.includes('## Footnotes')) {
      const parts = body.split('## Footnotes');
      body = parts[0];
      footer = '## Footnotes' + parts.slice(1).join('## Footnotes');
    }

    // 1. Hyphenated word break across page: word-\n...page...\nword -> wordword
    body = body.replace(
      /(\w+)-\s*\n+(?:<!--\s*PTS\s+Page\s*[^>]+-->\s*\n+)?(?:<a\s+id="page-[^"]+"><\/a>\s*\n+)?(?:#+\s*\*?\[PTS\s+Page\s*[^\]]+\]\*?\s*\n+)(\w+)/g,
      '$1$2'
    );

    // 2. Page break block across text: connect with space if in sentence, or paragraph break if sentence ended
    body = body.replace(
      /(\S[^\n]*)\s*\n+(?:<!--\s*PTS\s+Page\s*[^>]+-->\s*\n+)?(?:<a\s+id="page-[^"]+"><\/a>\s*\n+)?(?:#+\s*\*?\[PTS\s+Page\s*[^\]]+\]\*?\s*\n+)([^\s\n])/g,
      (_, pre: string, post: string) => {
        const preNoFn = pre.replace(/\[\^[^\]]+\]$/, '').trimEnd();
        if (/[.:;!?”"’']$/.test(preNoFn) || /^["“‘#]/.test(post)) {
          return `${pre}\n\n${post}`;
        }
        return `${pre} ${post}`;
      }
    );

    // Remaining standalone page markers / anchors
    body = body.replace(/<!--\s*PTS\s+Page\s*[^>]+-->\s*/gi, ' ');
    body = body.replace(/<a\s+id="page-[^"]+"><\/a>\s*/gi, ' ');
    body = body.replace(/#+\s*\*?\[PTS\s+Page\s*[^\]]+\]\*?\s*/gi, ' ');
    body = body.replace(/\[PTS\s+Page\s*[^\]]+\](?:\s*\[[\/\\a-zA-Z0-9 ]+\])?/gi, ' ');

    // 3. Paragraph numbers in double pipes: ||1||, ||2||, ||15||23||, || 1 ||
    body = body.replace(/\|\|\s*\d+(?:\s*\|\|\s*\d+)*\s*\|\|[ \t]*(?:  \n|\n|[ \t]+)?/g, ' ');

    // 4. Verse / section IDs in pipes or slashes: || Th_1 ||, // Dhp_1 //, || Ja_I:1 ||
    body = body.replace(/\|\|\s*(?:Ja|Th|Thī|Sn|Nidd|Ap|Cp|It|Vv|Pv|Dhp|Bv|F\.)_[^|\n]+?\s*\|\|[ \t]*/g, ' ');
    body = body.replace(/\/\/\s*(?:Dhp|Bv)_[^/\n]+?\s*\/\/[ \t]*/g, ' ');
    body = body.replace(/\b(?:JaNi_\d+|Ja_[A-Za-z0-9_.:]+):\s*/g, ' ');

    // 5. Leading paragraph numbers in prose: 1., 2., 1.1., (1) at line start
    body = body.replace(/^\s*(?:\d+(?:\.\d+)*\.|\(\d+\))\s+/gm, '');

    // 6. Double dandas / pipe delimiters: || || -> . and || -> ,
    body = body.replace(/\s*\|\|\s*\|\|\.?/g, '.');
    body = body.replace(/\s*\|\|/g, ',');
    body = body.replace(/,\s*,/g, ',');
    body = body.replace(/\.\s*\./g, '.');

    // 7. Normalize spaces and empty lines
    body = body.replace(/[ \t]{2,}/g, ' ');
    body = body.replace(/\n{3,}/g, '\n\n');

    return body.trim() + (footer ? '\n\n' + footer : '');
  }

  /**
   * Convert markdown string into HTML with link resolution, footnote rendering, and script transliteration
   */
  function convertMarkdownToHtml(markdown: string, filePath: string, edition: string, paneId: string = 'single'): string {
    let mdToParse = markdown;
    if (edition === 'pts') {
      mdToParse = cleanPtsForDisplay(mdToParse);
    }

    const { body: cleanedBody, definitions } = extractFootnotes(mdToParse);

    const usedFootnotes: Array<{ id: string; safeId: string; label: string; text: string }> = [];
    const seenRefs = new Set<string>();

    const renderedBody = cleanedBody.replace(/\[\^([^\]]+)\]/g, (_, rawId) => {
      const id = rawId.trim();
      const def = definitions.get(id) || definitions.get('p' + id) || (id.startsWith('p') ? definitions.get(id.slice(1)) : undefined) || '';
      const label = id.endsWith('-star') || id === 'star' ? '*' : id.replace(/^p0*|^0+/, '').replace(/^p/, '');
      const safeId = encodeURIComponent(id).replace(/%/g, '_');

      if (!seenRefs.has(id)) {
        seenRefs.add(id);
        usedFootnotes.push({ id, safeId, label: label || id, text: def });
      }

      const tooltipAttr = def ? ` title="${escapeHtml(def)}"` : '';
      return `<sup class="footnote-ref" id="fnref-${paneId}-${safeId}"><a href="#fn-${paneId}-${safeId}" class="footnote-link" data-footnote-ref="true" data-pane="${paneId}"${tooltipAttr}>[${escapeHtml(label || id)}]</a></sup>`;
    });

    const renderer = createMarkedRenderer(filePath, edition);
    let html = marked.parse(renderedBody, { renderer }) as string;

    if (usedFootnotes.length > 0) {
      const itemsHtml = usedFootnotes.map(fn => {
        return `<li id="fn-${paneId}-${fn.safeId}" class="footnote-item">` +
          `<span class="footnote-label"><strong>[${escapeHtml(fn.label)}]</strong></span> ` +
          `<span class="footnote-text">${escapeHtml(fn.text)}</span> ` +
          `<a href="#fnref-${paneId}-${fn.safeId}" class="footnote-backref" data-footnote-backref="true" data-pane="${paneId}" title="Back to text">↩</a>` +
          `</li>`;
      }).join('\n');

      html += `\n<div class="footnotes-section" role="doc-endnotes">\n<hr class="footnotes-sep" />\n<h4 class="footnotes-heading">Footnotes</h4>\n<ol class="footnotes-list">\n${itemsHtml}\n</ol>\n</div>`;
    } else if (definitions.size > 0) {
      const uniqueDefs = new Map<string, string>();
      for (const [k, v] of definitions.entries()) {
        const normKey = k.startsWith('p') && k.includes('-') ? k.slice(1) : k;
        if (!uniqueDefs.has(normKey)) {
          uniqueDefs.set(normKey, v);
        }
      }
      const itemsHtml = Array.from(uniqueDefs.entries()).map(([id, text]) => {
        const label = id.endsWith('-star') || id === 'star' ? '*' : id.replace(/^p0*|^0+/, '').replace(/^p/, '');
        const safeId = encodeURIComponent(id).replace(/%/g, '_');
        return `<li id="fn-${paneId}-${safeId}" class="footnote-item">` +
          `<span class="footnote-label"><strong>[${escapeHtml(label || id)}]</strong></span> ` +
          `<span class="footnote-text">${escapeHtml(text)}</span>` +
          `</li>`;
      }).join('\n');

      if (itemsHtml) {
        html += `\n<div class="footnotes-section" role="doc-endnotes">\n<hr class="footnotes-sep" />\n<h4 class="footnotes-heading">Footnotes</h4>\n<ol class="footnotes-list">\n${itemsHtml}\n</ol>\n</div>`;
      }
    }

    if (currentScript !== 'roman') {
      const notices: string[] = [];
      html = html.replace(/<div class="elision-notice[\s\S]*?<\/div>/g, (m) => {
        notices.push(m);
        return `<!--ELISION_NOTICE_${notices.length - 1}-->`;
      });

      html = transliteratePali(html, currentScript);

      html = html.replace(/<!--ELISION_NOTICE_(\d+)-->/g, (_, idx) => notices[parseInt(idx, 10)]);
    }
    return html;
  }

  /**
   * Check if a markdown page is an index/menu page (table of contents)
   * rather than a canonical Pali text page.
   */
  function isMenuPage(md: string, filePath?: string): boolean {
    const clean = (filePath || '').replace(/^\/+/, '');
    // Root book index: tipitaka/6D.md, tipitaka/1V.md, etc.
    if (/^tipitaka\/[0-9]+[A-Za-z0-9]*\.md$/i.test(clean) || clean === 'tipitaka/index.md' || clean === 'index.md') {
      return true;
    }
    if (!md) return false;

    // Filter out comments, navigation breadcrumbs, etc.
    const lines = md.split('\n')
      .map(l => l.trim())
      .filter(l => l && !l.startsWith('<!--') && !l.startsWith('<a ') && !l.startsWith('[Home]') && !l.startsWith('[Go to'));

    if (lines.length === 0) return true;

    // Non-header, non-blockquote lines (actual body lines)
    const contentLines = lines.filter(l => !l.startsWith('#') && !l.startsWith('>'));
    if (contentLines.length === 0) return true; // Only headings

    // Check how many content lines are list links to .md files
    const linkLines = contentLines.filter(l =>
      /^\*+\s+\[.+\]\(.+\.md(?:#[^)]*)?\)/.test(l) ||
      /^[-*]\s+\[.+\]\(.+\.md(?:#[^)]*)?\)/.test(l) ||
      /^\d+\.\s+\[.+\]\(.+\.md(?:#[^)]*)?\)/.test(l)
    );

    return linkLines.length >= 1 && (linkLines.length / contentLines.length) >= 0.35;
  }

  /**
   * Look up file path for a given book/sutta in an edition
   */
  function getFilePathForEdition(edition: string, bookCode: string, suttaId?: string): string {
    const normCode = normalizeBookCode(bookCode);
    // 1. If suttaId is provided and non-empty, look in catalog
    if (suttaId && catalog) {
      for (const pitaka of catalog.structure) {
        for (const book of pitaka.books) {
          if (book.suttas) {
            for (const s of book.suttas) {
              if (s.id.toLowerCase() === suttaId.toLowerCase()) {
                if (s.editions && s.editions[edition]) {
                  return s.editions[edition];
                }
              }
            }
          }
        }
      }
    }

    // 2. Book-level mapping in catalog
    if (catalog) {
      for (const pitaka of catalog.structure) {
        for (const book of pitaka.books) {
          if (book.code.toLowerCase() === normCode.toLowerCase() || book.code.toLowerCase() === bookCode.toLowerCase()) {
            if (book.editions && book.editions[edition]) {
              return book.editions[edition];
            }
            // Only fall back to first section or sutta if a specific suttaId was requested
            if (suttaId) {
              if (book.sections && book.sections.length > 0) {
                const s0 = book.sections[0];
                if (s0[edition]) return s0[edition] as string;
                if (s0.editions && (s0.editions as any)[edition]) return (s0.editions as any)[edition];
              }
              if (book.suttas && book.suttas.length > 0) {
                const s0 = book.suttas[0];
                if (s0.editions && s0.editions[edition]) {
                  return s0.editions[edition];
                }
              }
            }
          }
        }
      }
    }

    // 3. Fallback: return book-level menu path
    return `tipitaka/${normCode}.md`;
  }

  /**
   * Update active link in the sidebar and automatically expand the containing <details>
   */
  function updateActiveSidebarLink() {
    const normCode = normalizeBookCode(currentBookCode);
    const sidebarLinks = document.querySelectorAll('.sidebar-link');
    sidebarLinks.forEach((link) => {
      const href = (link as HTMLAnchorElement).getAttribute('href') || '';
      const isMatch =
        href.includes(`book=${currentBookCode}`) ||
        href.includes(`book=${normCode}`) ||
        href.endsWith(`/${currentBookCode}.html`) ||
        href.endsWith(`/${normCode}.html`) ||
        href.includes(`/${currentBookCode}.md`) ||
        href.includes(`/${normCode}.md`);

      if (isMatch) {
        link.classList.add('active');
        link.setAttribute('aria-current', 'page');

        let parent = link.closest('details');
        while (parent) {
          parent.open = true;
          parent = parent.parentElement ? parent.parentElement.closest('details') : null;
        }
      } else {
        link.classList.remove('active');
        link.removeAttribute('aria-current');
      }
    });
  }

  /**
   * Smooth client-side SPA navigation between reader texts and books
   */
  function navigateToUrl(href: string) {
    if (!href || href === '#' || href.startsWith('javascript:')) return;
    if (href === '/') {
      window.location.href = '/';
      return;
    }
    const url = new URL(href, window.location.origin);
    if (!url.pathname.endsWith('/reader.html') && url.pathname !== '/reader.html') {
      window.location.href = href;
      return;
    }

    const params = url.searchParams;
    singleShowFull = false;
    rightShowFull = false;

    const newEdition = params.get('edition');
    const newFile = params.get('file');
    const newBook = params.get('book');
    const newSutta = params.get('sutta');

    if (newEdition) currentEdition = newEdition;

    // Base edition should never show variants
    if (currentEdition === 'tipitaka2500') {
      diffEnabled = false;
    } else if (params.has('diff')) {
      diffEnabled = params.get('diff') === '1';
    } else {
      diffEnabled = true; // comparative editions enable diff by default
    }

    if (newFile) {
      if (newFile.startsWith('tipitaka/')) {
        currentSectionRef = newFile;
      } else {
        currentSectionRef = '';
      }
      const match = newFile.match(/tipitaka\/([0-9]+[A-Za-z0-9]*)/);
      if (match) {
        currentBookCode = normalizeBookCode(match[1]);
      } else if (newBook) {
        currentBookCode = normalizeBookCode(newBook);
      }
      currentSuttaId = newSutta || detectSuttaFromPath(newFile);

      if (currentEdition === 'tipitaka2500' || !newFile.startsWith('tipitaka/')) {
        currentFilePath = newFile;
      } else {
        currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId);
      }
    } else if (newSutta) {
      currentSuttaId = newSutta;
      if (newBook) currentBookCode = normalizeBookCode(newBook);
      currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId);
      currentSectionRef = getFilePathForEdition('tipitaka2500', currentBookCode, currentSuttaId);
    } else if (newBook) {
      currentBookCode = normalizeBookCode(newBook);
      currentSuttaId = '';
      currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, '');
      currentSectionRef = '';
    }

    const drawerToggle = document.getElementById('sidebar-drawer-toggle') as HTMLInputElement | null;
    if (drawerToggle) drawerToggle.checked = false;

    updateActiveSidebarLink();
    updateActiveEditionTabs();

    const targetRef = currentSectionRef || currentFilePath;
    const hashStr = url.hash || '';
    const diffQuery = currentEdition !== 'tipitaka2500' && diffEnabled ? '&diff=1' : '';
    window.history.pushState(
      {},
      '',
      `/reader.html?edition=${encodeURIComponent(currentEdition)}&book=${encodeURIComponent(currentBookCode)}${targetRef ? `&file=${encodeURIComponent(targetRef)}` : ''}&mode=${viewMode}${diffQuery}&script=${currentScript}${hashStr}`
    );
    updateView();
    if (!hashStr) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  /**
   * Intercept clicks on sidebar links for smooth client-side navigation
   */
  function attachSidebarLinkHandlers() {
    const sidebarLinks = document.querySelectorAll('aside.sidebar a');
    sidebarLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = (link as HTMLAnchorElement).getAttribute('href');
        if (!href) return;
        const url = new URL(href, window.location.origin);
        if (url.pathname === '/reader.html' || url.pathname.endsWith('/reader.html')) {
          e.preventDefault();
          navigateToUrl(href);
        }
      });
    });
  }

  /**
   * Intercept clicks on links inside rendered text
   */
  function attachReaderLinkHandlers() {
    const links = document.querySelectorAll('a[data-reader-link="true"]');
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = (link as HTMLAnchorElement).getAttribute('href');
        if (!href || href === '/' || href.startsWith('http://') || href.startsWith('https://')) {
          return;
        }
        e.preventDefault();
        navigateToUrl(href);
      });
    });
  }

  /**
   * Render the reader view dynamically based on current state
   */
  async function updateView() {
    const loadingEl = document.getElementById('reader-loading');
    const singlePaneView = document.getElementById('single-pane-view');
    const splitPanesView = document.getElementById('split-panes-view');
    const mainContentEl = document.getElementById('main-content');
    const leftContentEl = document.getElementById('left-content');
    const rightContentEl = document.getElementById('right-content');
    const diffLegend = document.getElementById('diff-legend');

    if (loadingEl) loadingEl.style.display = 'flex';

    // Retrieve Book and Pitaka metadata
    const bookInfo = getBookInfo(currentBookCode);
    const bookTitleStr = bookInfo ? `${currentBookCode} ${bookInfo.title}` : currentBookCode;
    const pitakaStr = bookInfo ? bookInfo.pitaka : '';

    const cleanCurrentPath = (currentFilePath || getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId)).replace(/^\/+/, '');
    const isRootBook =
      !currentFilePath ||
      cleanCurrentPath === `tipitaka/${currentBookCode}.md` ||
      cleanCurrentPath.endsWith(`/${currentBookCode}.md`);

    const targetFile = currentFilePath || getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId);
    const targetMd = await fetchMarkdown(currentEdition, targetFile);
    currentSingleFullMd = targetMd;

    const isMenu =
      isRootBook ||
      cleanCurrentPath === `tipitaka/${currentBookCode}.md` ||
      cleanCurrentPath.endsWith(`/${currentBookCode}.md`) ||
      isMenuPage(targetMd, targetFile) ||
      (currentSectionRef ? isMenuPage('', currentSectionRef) : false);

    // Update diff legend visibility: hide on base edition or menu pages
    if (diffLegend) {
      const isBase = currentEdition === 'tipitaka2500';
      const showLegend = !isBase && !isMenu && (diffEnabled || viewMode === 'split');
      diffLegend.style.display = showLegend ? 'flex' : 'none';
    }

    updateViewModeDropdown();

    // Calculate file URLs for single and split panes
    const edConfig = catalog?.editions[currentEdition];
    let repo = edConfig ? edConfig.repo : 'tipitaka-md/tipitaka2500';
    let branch = edConfig ? edConfig.branch : 'main';
    if (isMenu && cleanCurrentPath.startsWith('tipitaka/') && currentEdition !== 'tipitaka2500') {
      repo = 'tipitaka-md/tipitaka2500';
      branch = 'main';
    }

    const rawUrl = `https://raw.githubusercontent.com/${repo}/${branch}/${cleanCurrentPath}`;
    const githubUrl = `https://github.com/${repo}/blob/${branch}/${cleanCurrentPath}`;

    // Update Single-Pane Markdown Action links
    const rawLink = document.getElementById('raw-md-link') as HTMLAnchorElement;
    const githubLink = document.getElementById('github-md-link') as HTMLAnchorElement;
    if (rawLink) rawLink.href = rawUrl;
    if (githubLink) githubLink.href = githubUrl;

    if (isMenu) {
      // Menu page: render table of contents without elision or diffing
      if (splitPanesView) splitPanesView.style.display = 'none';
      if (singlePaneView) singlePaneView.style.display = 'block';

      currentSingleMd = targetMd;
      currentBaseSectionMd = targetMd;

      if (mainContentEl) {
        if (showRawMarkdown) {
          mainContentEl.innerHTML = `<pre class="raw-markdown-view"><code>${escapeHtml(targetMd)}</code></pre>`;
        } else {
          mainContentEl.innerHTML = convertMarkdownToHtml(targetMd, targetFile, currentEdition, 'single');
        }
      }
    } else if (viewMode === 'split') {
      if (singlePaneView) singlePaneView.style.display = 'none';
      if (splitPanesView) splitPanesView.style.display = 'flex';

      let leftFile = currentSectionRef || (currentEdition === 'tipitaka2500' ? currentFilePath : '') || getFilePathForEdition('tipitaka2500', currentBookCode, currentSuttaId);
      const rightFile = getFilePathForEdition(compareEdition, currentBookCode, currentSuttaId);

      let [baseMd, compareMd] = await Promise.all([
        fetchMarkdown('tipitaka2500', leftFile),
        fetchMarkdown(compareEdition, rightFile),
      ]);

      if (isMenuPage(baseMd, leftFile)) {
        const firstChildMatch = baseMd.match(/\*+\s+\[[^\]]+\]\(([^)]+\.md)\)/);
        if (firstChildMatch) {
          const relChild = firstChildMatch[1].trim();
          const resolvedChildUrl = resolveMarkdownLink(relChild, leftFile, 'tipitaka2500');
          const fileMatch = resolvedChildUrl.match(/file=([^&#]+)/);
          if (fileMatch) {
            leftFile = decodeURIComponent(fileMatch[1]);
            baseMd = await fetchMarkdown('tipitaka2500', leftFile);
          }
        }
      }

      currentLeftFullMd = baseMd;
      currentRightFullMd = compareMd;
      currentLeftMd = baseMd;
      currentBaseSectionMd = baseMd;

      const sectionTitle = extractTitleFromMarkdown(baseMd) || (currentSuttaId ? currentSuttaId.toUpperCase() : cleanCurrentPath.split('/').pop() || '');

      let rightRenderSource = compareMd;
      if (compareEdition === 'pts') {
        rightRenderSource = cleanPtsForDisplay(rightRenderSource);
      }
      if (!isRootBook && !rightShowFull) {
        const elided = elideOtherEdition(baseMd, rightRenderSource, sectionTitle, 'right');
        if (elided.isElided) {
          rightRenderSource = elided.content;
        }
      } else if (!isRootBook && rightShowFull) {
        rightRenderSource = `<div class="elision-notice elision-top"><span>Displaying complete file (${compareMd.split('\n').length} lines)</span><button type="button" class="btn-toggle-elision" data-pane="right">Elide non-relevant sections</button></div>\n\n` + rightRenderSource;
      }

      currentRightMd = rightRenderSource;

      // Update Left Pane links
      const leftClean = leftFile.replace(/^\/+/, '');
      const leftRawLink = document.getElementById('left-raw-link') as HTMLAnchorElement;
      const leftGhLink = document.getElementById('left-github-link') as HTMLAnchorElement;
      if (leftRawLink) leftRawLink.href = `https://raw.githubusercontent.com/tipitaka-md/tipitaka2500/main/${leftClean}`;
      if (leftGhLink) leftGhLink.href = `https://github.com/tipitaka-md/tipitaka2500/blob/main/${leftClean}`;

      // Update Right Pane links
      const rightConfig = catalog?.editions[compareEdition];
      const rightRepo = rightConfig ? rightConfig.repo : 'tipitaka-md/buddha-jayanthi';
      const rightBranch = rightConfig ? rightConfig.branch : 'main';
      const rightClean = rightFile.replace(/^\/+/, '');
      const rightRawLink = document.getElementById('right-raw-link') as HTMLAnchorElement;
      const rightGhLink = document.getElementById('right-github-link') as HTMLAnchorElement;
      if (rightRawLink) rightRawLink.href = `https://raw.githubusercontent.com/${rightRepo}/${rightBranch}/${rightClean}`;
      if (rightGhLink) rightGhLink.href = `https://github.com/${rightRepo}/blob/${rightBranch}/${rightClean}`;

      let rightRenderMd = rightRenderSource;
      if (diffEnabled) {
        rightRenderMd = highlightPaliDiff(rightRenderSource, baseMd, 'WTK');
      }

      if (leftContentEl) {
        if (showRawMarkdown) {
          leftContentEl.innerHTML = `<pre class="raw-markdown-view"><code>${escapeHtml(baseMd)}</code></pre>`;
        } else {
          leftContentEl.innerHTML = convertMarkdownToHtml(baseMd, leftFile, 'tipitaka2500', 'left');
        }
      }
      if (rightContentEl) {
        if (showRawMarkdown) {
          rightContentEl.innerHTML = `<pre class="raw-markdown-view"><code>${escapeHtml(compareMd)}</code></pre>`;
        } else {
          rightContentEl.innerHTML = convertMarkdownToHtml(rightRenderMd, rightFile, compareEdition, 'right');
        }
      }

      // Update pane headers
      const leftHeader = document.getElementById('left-pane-title');
      if (leftHeader) leftHeader.textContent = `🌟 ${bookTitleStr} · WTK (Base)`;

      const rightHeader = document.getElementById('right-pane-title');
      const rightBadge = document.getElementById('right-pane-badge');
      const edInfo = catalog?.editions[compareEdition];
      if (rightHeader && edInfo) rightHeader.textContent = `${edInfo.badge} ${bookTitleStr}`;
      if (rightBadge && edInfo) rightBadge.textContent = edInfo.short_name;

    } else {
      // Single pane view
      if (splitPanesView) splitPanesView.style.display = 'none';
      if (singlePaneView) singlePaneView.style.display = 'block';

      let singleRenderSource = targetMd;
      if (currentEdition === 'pts') {
        singleRenderSource = cleanPtsForDisplay(singleRenderSource);
      }

      if (!isRootBook && currentEdition !== 'tipitaka2500') {
        let baseFile = currentSectionRef || (currentFilePath.startsWith('tipitaka/') ? currentFilePath : '') || getFilePathForEdition('tipitaka2500', currentBookCode, currentSuttaId);
        let baseMd = await fetchMarkdown('tipitaka2500', baseFile);

        if (isMenuPage(baseMd, baseFile)) {
          const firstChildMatch = baseMd.match(/\*+\s+\[[^\]]+\]\(([^)]+\.md)\)/);
          if (firstChildMatch) {
            const relChild = firstChildMatch[1].trim();
            const resolvedChildUrl = resolveMarkdownLink(relChild, baseFile, 'tipitaka2500');
            const fileMatch = resolvedChildUrl.match(/file=([^&#]+)/);
            if (fileMatch) {
              baseFile = decodeURIComponent(fileMatch[1]);
              baseMd = await fetchMarkdown('tipitaka2500', baseFile);
            }
          }
        }

        currentBaseSectionMd = baseMd;
        const sectionTitle = extractTitleFromMarkdown(baseMd) || (currentSuttaId ? currentSuttaId.toUpperCase() : cleanCurrentPath.split('/').pop() || '');

        if (!singleShowFull) {
          const elided = elideOtherEdition(baseMd, singleRenderSource, sectionTitle, 'single');
          if (elided.isElided) {
            singleRenderSource = elided.content;
          }
        } else {
          singleRenderSource = `<div class="elision-notice elision-top"><span>Displaying complete file (${targetMd.split('\n').length} lines)</span><button type="button" class="btn-toggle-elision" data-pane="single">Elide non-relevant sections</button></div>\n\n` + singleRenderSource;
        }

        currentSingleMd = singleRenderSource;
        let renderMd = singleRenderSource;
        if (diffEnabled) {
          renderMd = highlightPaliDiff(singleRenderSource, baseMd, 'WTK');
        }

        if (mainContentEl) {
          if (showRawMarkdown) {
            mainContentEl.innerHTML = `<pre class="raw-markdown-view"><code>${escapeHtml(targetMd)}</code></pre>`;
          } else {
            mainContentEl.innerHTML = convertMarkdownToHtml(renderMd, targetFile, currentEdition, 'single');
          }
        }
      } else {
        // currentEdition === 'tipitaka2500' (Base edition: never show variants)
        currentSingleMd = targetMd;
        currentBaseSectionMd = targetMd;

        if (mainContentEl) {
          if (showRawMarkdown) {
            mainContentEl.innerHTML = `<pre class="raw-markdown-view"><code>${escapeHtml(targetMd)}</code></pre>`;
          } else {
            mainContentEl.innerHTML = convertMarkdownToHtml(targetMd, targetFile, currentEdition, 'single');
          }
        }
      }
    }

    // Update Breadcrumbs and Document Title with extracted section/sutta title
    const activeMd = viewMode === 'split' ? currentLeftMd : currentSingleMd;
    const extractedTitle = extractTitleFromMarkdown(activeMd);
    const subTitle = extractedTitle || (currentSuttaId ? currentSuttaId.toUpperCase() : cleanCurrentPath.split('/').pop() || '');

    const breadcrumbsEl = document.getElementById('reader-breadcrumbs');
    if (breadcrumbsEl) {
      if (isRootBook) {
        breadcrumbsEl.innerHTML = `
          <li><a href="/">Home</a></li>
          ${pitakaStr ? `<li><a href="/#canon-directory">${pitakaStr}</a></li>` : ''}
          <li aria-current="page">${bookTitleStr}</li>
        `;
      } else {
        breadcrumbsEl.innerHTML = `
          <li><a href="/">Home</a></li>
          <li><a href="/reader.html?edition=${encodeURIComponent(currentEdition)}&book=${encodeURIComponent(currentBookCode)}">${bookTitleStr}</a></li>
          <li aria-current="page">${subTitle}</li>
        `;
      }
    }

    // Update Document Title
    if (isRootBook) {
      document.title = `${bookTitleStr} — Tipitaka Editions in Markdown`;
    } else {
      document.title = `${subTitle} · ${bookTitleStr} — Tipitaka Editions in Markdown`;
    }

    if (loadingEl) loadingEl.style.display = 'none';
    attachReaderLinkHandlers();
    updateNavigationButtons();
    scrollToParagraphHash();
  }

  /**
   * Scroll to and highlight paragraph anchor if URL hash is present (e.g. #p41 or #p0041)
   */
  function scrollToParagraphHash() {
    const hash = window.location.hash;
    if (!hash) return;
    const match = hash.match(/^#p(?:ar-)?0*(\d+)$/i);
    if (match) {
      const num = parseInt(match[1], 10);
      setTimeout(() => {
        const target =
          document.getElementById(`p${num}`) ||
          document.querySelector(`[data-par="${num}"]`) ||
          document.getElementById(`par-${num}`);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.classList.remove('wtk-paragraph-highlight');
          void (target as HTMLElement).offsetWidth;
          target.classList.add('wtk-paragraph-highlight');
          setTimeout(() => {
            target.classList.remove('wtk-paragraph-highlight');
          }, 4500);
        }
      }, 150);
    }
  }

  function getAllCanonicalBooks(): Array<{ code: string; title: string }> {
    if (!catalog) return [];
    const books: Array<{ code: string; title: string }> = [];
    for (const p of catalog.structure) {
      for (const b of p.books) {
        books.push({ code: b.code, title: b.title });
      }
    }
    return books;
  }

  /**
   * Update header and bottom navigation buttons (previous, next, and parent)
   */
  function updateNavigationButtons() {
    const headerPrevBtn = document.getElementById('header-prev-btn') as HTMLAnchorElement | null;
    const headerNextBtn = document.getElementById('header-next-btn') as HTMLAnchorElement | null;
    const footerPrevBtn = document.getElementById('footer-prev-btn') as HTMLAnchorElement | null;
    const footerNextBtn = document.getElementById('footer-next-btn') as HTMLAnchorElement | null;
    const footerPrevTitle = document.getElementById('footer-prev-title');
    const footerNextTitle = document.getElementById('footer-next-title');
    const parentBtn = document.getElementById('parent-book-btn') as HTMLAnchorElement | null;
    const parentTitle = document.getElementById('parent-book-title');

    const cleanCurrentPath = (currentFilePath || getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId)).replace(/^\/+/, '');
    const isRootBook =
      !currentFilePath ||
      cleanCurrentPath === `tipitaka/${currentBookCode}.md` ||
      cleanCurrentPath.endsWith(`/${currentBookCode}.md`);

    let prevNav: { href: string; title: string } | null = null;
    let nextNav: { href: string; title: string } | null = null;
    let parentNav: { href: string; title: string } = {
      href: `/reader.html?edition=${encodeURIComponent(currentEdition)}&book=${encodeURIComponent(currentBookCode)}`,
      title: `${currentBookCode} Index`
    };

    const allBooks = getAllCanonicalBooks();
    const currentBookIdx = allBooks.findIndex(
      b => b.code.toLowerCase() === normalizeBookCode(currentBookCode).toLowerCase()
    );

    // 1. Try extracting [Go to previous/next page] from canonical markdown
    const mdToCheck = currentBaseSectionMd || currentSingleFullMd || currentSingleMd || currentLeftFullMd;
    const fromPath = currentSectionRef || (currentFilePath.startsWith('tipitaka/') ? currentFilePath : '') || `tipitaka/${currentBookCode}.md`;

    if (mdToCheck) {
      const prevMatch = mdToCheck.match(/\[Go to previous page\s*\(([^)]+)\)\]\(([^)]+)\)/i);
      const nextMatch = mdToCheck.match(/\[Go to next page\s*\(([^)]+)\)\]\(([^)]+)\)/i);
      const parentMatch = mdToCheck.match(/\[Go to parent page\s*\(([^)]+)\)\]\(([^)]+)\)/i);

      if (prevMatch) {
        prevNav = {
          title: prevMatch[1].trim(),
          href: resolveMarkdownLink(prevMatch[2].trim(), fromPath, currentEdition)
        };
      }
      if (nextMatch) {
        nextNav = {
          title: nextMatch[1].trim(),
          href: resolveMarkdownLink(nextMatch[2].trim(), fromPath, currentEdition)
        };
      }
      if (parentMatch) {
        parentNav = {
          title: parentMatch[1].trim(),
          href: resolveMarkdownLink(parentMatch[2].trim(), fromPath, currentEdition)
        };
      }
    }

    // 2. If at root book (or prev/next not in markdown), fall back to canonical book list
    if (isRootBook) {
      parentNav = {
        href: '/',
        title: 'Canon Home'
      };
      if (currentBookIdx > 0) {
        const pBook = allBooks[currentBookIdx - 1];
        prevNav = {
          title: `${pBook.code} ${pBook.title}`,
          href: `/reader.html?edition=${encodeURIComponent(currentEdition)}&book=${encodeURIComponent(pBook.code)}`
        };
      }
      if (currentBookIdx >= 0 && currentBookIdx < allBooks.length - 1) {
        const nBook = allBooks[currentBookIdx + 1];
        nextNav = {
          title: `${nBook.code} ${nBook.title}`,
          href: `/reader.html?edition=${encodeURIComponent(currentEdition)}&book=${encodeURIComponent(nBook.code)}`
        };
      }
    }

    // Update Previous button UI
    if (prevNav) {
      if (headerPrevBtn) {
        headerPrevBtn.href = prevNav.href;
        headerPrevBtn.classList.remove('disabled');
        headerPrevBtn.removeAttribute('aria-disabled');
        headerPrevBtn.title = `Previous: ${prevNav.title} (Alt+Left or [)`;
      }
      if (footerPrevBtn) {
        footerPrevBtn.href = prevNav.href;
        footerPrevBtn.classList.remove('disabled');
        footerPrevBtn.removeAttribute('aria-disabled');
        footerPrevBtn.title = `Previous: ${prevNav.title}`;
      }
      if (footerPrevTitle) {
        footerPrevTitle.textContent = prevNav.title;
      }
    } else {
      if (headerPrevBtn) {
        headerPrevBtn.href = '#';
        headerPrevBtn.classList.add('disabled');
        headerPrevBtn.setAttribute('aria-disabled', 'true');
        headerPrevBtn.title = 'No previous text';
      }
      if (footerPrevBtn) {
        footerPrevBtn.href = '#';
        footerPrevBtn.classList.add('disabled');
        footerPrevBtn.setAttribute('aria-disabled', 'true');
        footerPrevBtn.title = 'Beginning of book';
      }
      if (footerPrevTitle) {
        footerPrevTitle.textContent = 'Beginning';
      }
    }

    // Update Next button UI
    if (nextNav) {
      if (headerNextBtn) {
        headerNextBtn.href = nextNav.href;
        headerNextBtn.classList.remove('disabled');
        headerNextBtn.removeAttribute('aria-disabled');
        headerNextBtn.title = `Next: ${nextNav.title} (Alt+Right or ])`;
      }
      if (footerNextBtn) {
        footerNextBtn.href = nextNav.href;
        footerNextBtn.classList.remove('disabled');
        footerNextBtn.removeAttribute('aria-disabled');
        footerNextBtn.title = `Next: ${nextNav.title}`;
      }
      if (footerNextTitle) {
        footerNextTitle.textContent = nextNav.title;
      }
    } else {
      if (headerNextBtn) {
        headerNextBtn.href = '#';
        headerNextBtn.classList.add('disabled');
        headerNextBtn.setAttribute('aria-disabled', 'true');
        headerNextBtn.title = 'No next text';
      }
      if (footerNextBtn) {
        footerNextBtn.href = '#';
        footerNextBtn.classList.add('disabled');
        footerNextBtn.setAttribute('aria-disabled', 'true');
        footerNextBtn.title = 'End of book';
      }
      if (footerNextTitle) {
        footerNextTitle.textContent = 'End';
      }
    }

    // Update Parent button UI
    if (parentBtn) {
      parentBtn.href = parentNav.href;
      parentBtn.title = `Go to ${parentNav.title}`;
    }
    if (parentTitle) {
      parentTitle.textContent = parentNav.title;
    }
  }

  /**
   * Update active UI states for edition tabs and view mode dropdown
   */
  function updateActiveEditionTabs() {
    const tabs = document.querySelectorAll('.edition-tab');
    tabs.forEach((tab) => {
      const ed = tab.getAttribute('data-edition');
      if (ed === currentEdition) {
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
      } else {
        tab.classList.remove('active');
        tab.setAttribute('aria-selected', 'false');
      }
    });
    updateViewModeDropdown();
  }

  function updateControlsVisibility() {
    const diffLegend = document.getElementById('diff-legend');
    const diffBtn = document.getElementById('diff-toggle-btn');
    const isBase = currentEdition === 'tipitaka2500';

    if (diffBtn) {
      if (isBase) {
        diffBtn.style.display = 'none';
      } else {
        diffBtn.style.display = 'inline-flex';
        diffBtn.classList.toggle('active', diffEnabled);
        diffBtn.setAttribute('aria-pressed', diffEnabled ? 'true' : 'false');
      }
    }

    if (diffLegend) {
      const curPath = (currentFilePath || '').replace(/^\/+/, '');
      const isCurrentMenu =
        isMenuPage(currentSingleMd || currentBaseSectionMd, currentSectionRef || currentFilePath) ||
        curPath === `tipitaka/${currentBookCode}.md` ||
        curPath.endsWith(`/${currentBookCode}.md`);
      const showLegend = !isBase && !isCurrentMenu && (diffEnabled || viewMode === 'split');
      diffLegend.style.display = showLegend ? 'flex' : 'none';
    }
  }

  function updateViewModeDropdown() {
    const viewModeSelect = document.getElementById('view-mode-select') as HTMLSelectElement | null;
    if (!viewModeSelect) return;
    const isBase = currentEdition === 'tipitaka2500';
    const splitOption = viewModeSelect.querySelector('option[value="split"]') as HTMLOptionElement | null;
    const curPath = (currentFilePath || '').replace(/^\/+/, '');
    const isCurrentMenu =
      isMenuPage(currentSingleMd || currentBaseSectionMd, currentSectionRef || currentFilePath) ||
      curPath === `tipitaka/${currentBookCode}.md` ||
      curPath.endsWith(`/${currentBookCode}.md`);

    if (isCurrentMenu) {
      if (splitOption) {
        splitOption.disabled = true;
        splitOption.textContent = '⚖️ Side-by-Side (Unavailable on menu)';
      }
      viewModeSelect.title = 'Side-by-Side comparison is not available on index/menu pages';
      if (viewMode === 'split') {
        viewMode = 'single';
      }
    } else if (isBase) {
      if (splitOption) {
        splitOption.disabled = true;
        splitOption.textContent = '⚖️ Side-by-Side (Select an edition)';
      }
      viewModeSelect.title = 'Select another edition tab (PTS, BJT, CST, RTE) to enable Side-by-Side comparison against WTK';
      if (viewMode === 'split') {
        viewMode = 'single';
      }
    } else {
      if (splitOption) {
        splitOption.disabled = false;
        const edInfo = catalog?.editions[currentEdition];
        const shortName = edInfo ? edInfo.short_name : currentEdition.toUpperCase();
        splitOption.textContent = `⚖️ Side-by-Side (WTK vs ${shortName})`;
      }
      viewModeSelect.title = 'Toggle Single View or Side-by-Side Comparison against WTK';
    }
    viewModeSelect.value = viewMode;
    updateControlsVisibility();
  }

  // Setup Event Listeners
  function setupEventListeners() {
    // Edition Tabs
    const tabs = document.querySelectorAll('.edition-tab');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const ed = tab.getAttribute('data-edition');
        if (ed && ed !== currentEdition) {
          const curPath = (currentFilePath || '').replace(/^\/+/, '');
          const isCurrentlyMenu =
            isMenuPage(currentSingleMd || currentBaseSectionMd, currentSectionRef || currentFilePath) ||
            curPath === `tipitaka/${currentBookCode}.md` ||
            curPath.endsWith(`/${currentBookCode}.md`) ||
            !currentFilePath;

          currentEdition = ed;
          if (currentEdition !== 'tipitaka2500') {
            compareEdition = currentEdition;
            diffEnabled = true; // Clicking on another edition enables the diff
          } else {
            viewMode = 'single';
            diffEnabled = false; // Base edition should never show variants
          }
          singleShowFull = false;
          rightShowFull = false;

          if (isCurrentlyMenu) {
            // Stay on the menu page across editions
            currentFilePath = currentSectionRef || currentFilePath || `tipitaka/${currentBookCode}.md`;
            currentSuttaId = '';
          } else if (currentEdition === 'tipitaka2500' && currentSectionRef) {
            currentFilePath = currentSectionRef;
          } else {
            currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId);
          }

          const newUrl = new URL(window.location.href);
          newUrl.searchParams.set('edition', currentEdition);
          newUrl.searchParams.set('mode', viewMode);
          if (currentEdition !== 'tipitaka2500' && diffEnabled) {
            newUrl.searchParams.set('diff', '1');
          } else {
            newUrl.searchParams.delete('diff');
          }
          if (currentFilePath) {
            newUrl.searchParams.set('file', currentFilePath);
          }
          window.history.pushState({}, '', newUrl.toString());

          updateActiveEditionTabs();
          updateControlsVisibility();
          updateView();
        }
      });
    });

    // View Mode Select
    const viewModeSelect = document.getElementById('view-mode-select') as HTMLSelectElement;

    if (viewModeSelect) {
      viewModeSelect.value = viewMode;
      viewModeSelect.addEventListener('change', () => {
        viewMode = viewModeSelect.value;
        updateControlsVisibility();
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('mode', viewMode);
        window.history.pushState({}, '', newUrl.toString());
        updateView();
      });
    }

    // Variant Diff Toggle
    const diffBtn = document.getElementById('diff-toggle-btn');
    if (diffBtn) {
      diffBtn.addEventListener('click', () => {
        if (currentEdition === 'tipitaka2500') return; // Base edition never shows variants
        diffEnabled = !diffEnabled;
        updateControlsVisibility();
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('diff', diffEnabled ? '1' : '0');
        window.history.pushState({}, '', newUrl.toString());
        updateView();
      });
    }

    updateControlsVisibility();

    // Script Select
    const scriptSelect = document.getElementById('script-select') as HTMLSelectElement;
    if (scriptSelect) {
      scriptSelect.value = currentScript;
      scriptSelect.addEventListener('change', () => {
        currentScript = scriptSelect.value;
        updateView();
      });
    }

    // Download Markdown file buttons (always downloads full genuine file from repository)
    const downloadBtn = document.getElementById('download-md-btn');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', () => {
        const targetFile = currentFilePath || getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId);
        const fileName = (targetFile.split('/').pop() || `${currentBookCode}.md`).replace(/\.html$/, '.md');
        downloadMarkdownFile(fileName, currentSingleFullMd || currentSingleMd);
      });
    }

    const leftDownloadBtn = document.getElementById('left-download-btn');
    if (leftDownloadBtn) {
      leftDownloadBtn.addEventListener('click', () => {
        const leftFile = currentFilePath || getFilePathForEdition('tipitaka2500', currentBookCode, currentSuttaId);
        const fileName = (leftFile.split('/').pop() || `${currentBookCode}_tipitaka2500.md`).replace(/\.html$/, '.md');
        downloadMarkdownFile(fileName, currentLeftFullMd || currentLeftMd);
      });
    }

    const rightDownloadBtn = document.getElementById('right-download-btn');
    if (rightDownloadBtn) {
      rightDownloadBtn.addEventListener('click', () => {
        const rightFile = getFilePathForEdition(compareEdition, currentBookCode, currentSuttaId);
        const fileName = (rightFile.split('/').pop() || `${currentBookCode}_${compareEdition}.md`).replace(/\.html$/, '.md');
        downloadMarkdownFile(fileName, currentRightFullMd || currentRightMd);
      });
    }

    // Toggle Section Elision (Show full file / Elide non-relevant sections)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.btn-toggle-elision') as HTMLButtonElement;
      if (!target) return;
      const pane = target.getAttribute('data-pane');
      if (pane === 'right') {
        rightShowFull = !rightShowFull;
        updateView();
      } else if (pane === 'single') {
        singleShowFull = !singleShowFull;
        updateView();
      }
    });

    // Smooth navigation and highlight for Footnote Callouts and Backlinks
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const fnLink = target?.closest('a[data-footnote-ref], a[data-footnote-backref]') as HTMLAnchorElement | null;
      if (fnLink) {
        const href = fnLink.getAttribute('href');
        if (href && href.startsWith('#')) {
          e.preventDefault();
          const targetId = href.slice(1);
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetEl.classList.remove('footnote-target-highlight');
            void targetEl.offsetWidth; // Trigger reflow to restart pulse
            targetEl.classList.add('footnote-target-highlight');
          }
        }
      }
    });

    // Toggle Raw Markdown View
    const toggleRawBtn = document.getElementById('toggle-raw-btn');
    const toggleRawLabel = document.getElementById('toggle-raw-label');
    if (toggleRawBtn) {
      toggleRawBtn.addEventListener('click', () => {
        showRawMarkdown = !showRawMarkdown;
        if (toggleRawLabel) {
          toggleRawLabel.textContent = showRawMarkdown ? '📖 Formatted' : '👁️ Raw View';
        }
        updateView();
      });
    }

    // Synchronized Scrolling in Split Mode
    const leftPane = document.getElementById('left-pane');
    const rightPane = document.getElementById('right-pane');
    let isSyncingLeft = false;
    let isSyncingRight = false;

    if (leftPane && rightPane) {
      leftPane.addEventListener('scroll', () => {
        if (isSyncingLeft) return;
        isSyncingRight = true;
        const percentage = leftPane.scrollTop / (leftPane.scrollHeight - leftPane.clientHeight || 1);
        rightPane.scrollTop = percentage * (rightPane.scrollHeight - rightPane.clientHeight);
        requestAnimationFrame(() => { isSyncingRight = false; });
      });

      rightPane.addEventListener('scroll', () => {
        if (isSyncingRight) return;
        isSyncingLeft = true;
        const percentage = rightPane.scrollTop / (rightPane.scrollHeight - rightPane.clientHeight || 1);
        leftPane.scrollTop = percentage * (leftPane.scrollHeight - leftPane.clientHeight);
        requestAnimationFrame(() => { isSyncingLeft = false; });
      });
    }

    // Sidebar Link Handlers
    attachSidebarLinkHandlers();

    // Header and Footer Navigation Button Handlers
    const navButtons = [
      document.getElementById('header-prev-btn'),
      document.getElementById('header-next-btn'),
      document.getElementById('footer-prev-btn'),
      document.getElementById('footer-next-btn'),
      document.getElementById('parent-book-btn'),
    ];

    navButtons.forEach((btn) => {
      if (btn) {
        btn.addEventListener('click', (e) => {
          const href = (btn as HTMLAnchorElement).getAttribute('href');
          if (!href || href === '#' || btn.classList.contains('disabled')) return;
          e.preventDefault();
          navigateToUrl(href);
        });
      }
    });

    // Keyboard navigation shortcuts: Alt+Left / [ for Previous, Alt+Right / ] for Next
    document.addEventListener('keydown', (e) => {
      const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
      if (
        activeTag === 'input' ||
        activeTag === 'textarea' ||
        activeTag === 'select' ||
        (document.activeElement as HTMLElement)?.isContentEditable
      ) {
        return;
      }

      if ((e.key === 'ArrowLeft' && e.altKey) || e.key === '[') {
        const prevBtn = document.getElementById('footer-prev-btn') as HTMLAnchorElement | null;
        if (prevBtn && !prevBtn.classList.contains('disabled')) {
          const href = prevBtn.getAttribute('href');
          if (href && href !== '#') {
            e.preventDefault();
            navigateToUrl(href);
          }
        }
      } else if ((e.key === 'ArrowRight' && e.altKey) || e.key === ']') {
        const nextBtn = document.getElementById('footer-next-btn') as HTMLAnchorElement | null;
        if (nextBtn && !nextBtn.classList.contains('disabled')) {
          const href = nextBtn.getAttribute('href');
          if (href && href !== '#') {
            e.preventDefault();
            navigateToUrl(href);
          }
        }
      }
    });

    // Handle Browser PopState (Back / Forward)
    window.addEventListener('popstate', () => {
      parseUrlParams();
      updateActiveSidebarLink();
      updateActiveEditionTabs();
      updateView();
      scrollToParagraphHash();
    });

    // Handle hash change for paragraph deep linking
    window.addEventListener('hashchange', scrollToParagraphHash);
  }

  /**
   * Parse query parameters on initial page load or popstate
   */
  function parseUrlParams() {
    singleShowFull = false;
    rightShowFull = false;

    const params = new URLSearchParams(window.location.search);
    if (params.has('edition')) {
      currentEdition = params.get('edition')!;
      if (currentEdition !== 'tipitaka2500') {
        compareEdition = currentEdition;
      }
    }
    if (params.has('compare')) compareEdition = params.get('compare')!;
    if (params.has('mode')) viewMode = params.get('mode')!;
    if (params.has('script')) currentScript = params.get('script')!;

    // Base edition should never show variants
    if (currentEdition === 'tipitaka2500') {
      diffEnabled = false;
    } else if (params.has('diff')) {
      diffEnabled = params.get('diff') === '1';
    } else {
      diffEnabled = true; // comparative editions enable diff by default
    }

    if (params.has('file')) {
      const paramFile = params.get('file')!;
      if (paramFile.startsWith('tipitaka/')) {
        currentSectionRef = paramFile;
      } else {
        currentSectionRef = '';
      }
      const m = paramFile.match(/tipitaka\/([0-9]+[A-Za-z0-9]*)/);
      if (m) {
        currentBookCode = normalizeBookCode(m[1]);
      }

      const isParamFileMenu = /^tipitaka\/[0-9]+[A-Za-z0-9]*\.md$/i.test(paramFile) || paramFile === 'tipitaka/index.md';
      if (isParamFileMenu) {
        currentSuttaId = '';
        currentFilePath = paramFile;
      } else {
        currentSuttaId = params.get('sutta') || detectSuttaFromPath(paramFile);

        if (currentEdition === 'tipitaka2500' || !paramFile.startsWith('tipitaka/')) {
          currentFilePath = paramFile;
        } else {
          currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId);
        }
      }
    } else if (params.has('sutta')) {
      currentSuttaId = params.get('sutta')!;
      if (params.has('book')) {
        currentBookCode = normalizeBookCode(params.get('book')!);
      }
      currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, currentSuttaId);
      currentSectionRef = getFilePathForEdition('tipitaka2500', currentBookCode, currentSuttaId);
    } else if (params.has('book')) {
      currentBookCode = normalizeBookCode(params.get('book')!);
      currentSuttaId = '';
      currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, '');
      currentSectionRef = '';
    } else {
      currentBookCode = '1V';
      currentSuttaId = '';
      currentFilePath = getFilePathForEdition(currentEdition, currentBookCode, '');
      currentSectionRef = '';
    }
  }

  // Initialization
  async function init() {
    try {
      const res = await fetch('/catalog.json', { cache: 'no-store' });
      if (res.ok) {
        catalog = await res.json();
      }
    } catch (err) {
      console.warn('Could not load catalog.json:', err);
    }

    parseUrlParams();
    setupEventListeners();
    updateActiveSidebarLink();
    updateActiveEditionTabs();
    updateView();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
