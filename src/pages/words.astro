    "thai": "\u0e18\u0e31\u0e21\u0e4c\u0e21\u0e1b\u0e31\u0e08\u0e4c\u0e08\u0e19\u0e35\u0e22\u0e32\u0e19\u0e38\u0e42\u0e25\u0e21 (4), \u0e15\u0e34\u0e01\u0e15\u0e34\u0e01\u0e1b\u0e31\u0e0f\u0e4c\u0e10\u0e32\u0e19\u0e1b\u0e32\u0e2c\u0e34 (5) (40P23)",
    "pitaka": "ABH",
