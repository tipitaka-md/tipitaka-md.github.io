            <p style="color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 1rem;">
              {section.desc}
            </p>

            <div class="home-index-grid">
              {section.books.map((book) => (
                <a
                  href={`/reader.html?book=${encodeURIComponent(book.code)}`}
                  class="home-index-card"
                  title={`Open ${book.title} (${book.code}) in Reader`}
                >
                  <div>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem;">
                      <span class="badge-code" style="font-size: 0.82rem; font-weight: 700;">
                        {book.code}
                      </span>
                      <span style="font-size: 0.8rem; color: var(--text-secondary); font-style: italic;">
                        {book.pali}
                      </span>
                    </div>
                    <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 0.35rem; color: var(--text-emphasis);">
                      {book.title}
                    </h4>
                    <p style="font-size: 0.88rem; line-height: 1.5; margin: 0;">
                      {book.desc}
                    </p>
                  </div>
                  <span class="home-index-stat">Read →</span>
                </a>
              ))}
            </div>
          </div>
        ))}
