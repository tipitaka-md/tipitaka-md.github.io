---
import { Font } from 'astro:assets';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  currentBook?: string;
  tocSectionPath?: string;
  lang?: string;
  ogType?: 'website' | 'article' | 'book';
  ogImage?: string;
  ogImageAlt?: string;
  keywords?: string;
  prevUrl?: string;
  nextUrl?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = 'Tipitaka Editions in Markdown: digital reader showcasing canonical Pāḷi Tipiṭaka texts across 5 open Markdown repositories (World Tipiṭaka Edition WT base, Pali Text Society, Buddha Jayanthi, Chaṭṭha Saṅgāyana CST, and Royal Thai Edition RT) with real-time variant highlighting, dictionary lookup, and multi-script transliteration.',
  currentBook = '',
  tocSectionPath = '',
  lang = 'en',
  ogType = 'website',
  ogImage = '/images/lotus-og.jpg',
  ogImageAlt = 'Lotus flower',
  keywords = 'Tipitaka Editions in Markdown, Pāḷi Tipiṭaka, tipitaka-md, World Tipitaka Edition, WT, Pali Text Society, PTS, Buddha Jayanthi, BJ, Chaṭṭha Saṅgāyana, CST, Royal Thai Edition, RT, Siam Rath, Vinayapiṭaka, Suttantapiṭaka, Abhidhammapiṭaka, Markdown',
  prevUrl = '',
  nextUrl = '',
  breadcrumbs = [],
} = Astro.props;

const pageTitle = title ? `${title} — Tipitaka Editions in Markdown` : 'Tipitaka Editions in Markdown';

const siteOrigin = (Astro.site ? Astro.site.origin : 'https://tipitaka-md.github.io').replace(
  /\/$/,
  ''
);
const rawPathname = Astro.url.pathname || '/';
const normalizedPath =
  rawPathname === '/' || rawPathname === '/index.html'
    ? '/'
    : rawPathname.endsWith('.html')
      ? rawPathname
      : `${rawPathname.replace(/\/$/, '')}.html`;
const canonicalUrl = `${siteOrigin}${normalizedPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage}`;

const jsonLdGraph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    url: `${siteOrigin}/`,
    name: 'Tipitaka Editions in Markdown',
    alternateName: 'tipitaka-md.github.io',
    description:
      'Comparative digital reader showcasing canonical Pāḷi Tipiṭaka texts converted to Markdown across the tipitaka-md repositories with text variant highlighting, dictionary lookup, and multi-script transliteration.',
    inLanguage: ['pi', 'en'],
    license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  },
  {
    '@type': ogType === 'article' ? 'Chapter' : 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: pageTitle,
    description,
    inLanguage: lang,
    isPartOf: { '@id': `${siteOrigin}/#website` },
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: ogImageUrl,
      width: 1200,
      height: 630,
      caption: ogImageAlt,
    },
  },
];

if (breadcrumbs.length > 0) {
  jsonLdGraph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      item: b.url.startsWith('http') ? b.url : `${siteOrigin}${b.url}`,
    })),
  });
}

const jsonLdString = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': jsonLdGraph,
});
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Chris Tham" />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light dark" />

    <script is:inline>
      try {
        if (localStorage.getItem('tipitaka-sidebar-collapsed') === 'true' && window.innerWidth > 768) {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    </script>

    <script is:inline define:vars={{ siteBuildId: __SITE_BUILD_ID__ }}>
      const refreshedUrl = new URL(window.location.href);
      if (refreshedUrl.searchParams.has('_sw_refresh')) {
        refreshedUrl.searchParams.delete('_sw_refresh');
        history.replaceState(history.state, '', refreshedUrl.href);
        // Put the reader back where they were before the update reload
        try {
          const saved = JSON.parse(sessionStorage.getItem('tipitaka-refresh-scroll') || 'null');
          sessionStorage.removeItem('tipitaka-refresh-scroll');
          if (saved && saved.path === refreshedUrl.pathname + refreshedUrl.search && typeof saved.y === 'number') {
            window.__tipitakaRestoreScroll = saved.y;
            // Static pages restore on load; the reader restores after its first render
            window.addEventListener('load', () => {
              const pane = document.querySelector('.content-pane');
              if (typeof window.__tipitakaRestoreScroll === 'number' && pane) pane.scrollTop = window.__tipitakaRestoreScroll;
            });
          }
        } catch {}
      }

      (() => {
        const retryDelay = 10 * 60 * 1000;
        const checkInterval = 60 * 1000;
        let lastCheck = 0;
        let checking = false;

        async function checkForUpdate() {
          if (checking || document.visibilityState !== 'visible' || Date.now() - lastCheck < checkInterval) return;
          checking = true;
          lastCheck = Date.now();
          try {
            const response = await fetch('/site-version.json', { cache: 'no-store' });
            if (!response.ok) throw new Error(`Version check failed: HTTP ${response.status}`);
            const data = await response.json();
            if (typeof data.version !== 'string' || !data.version) throw new Error('Invalid site version');
            if (data.version === siteBuildId) return;

            const key = 'tipitaka-update-attempt';
            const previous = JSON.parse(sessionStorage.getItem(key) || 'null');
            if (previous?.version === data.version && Date.now() - previous.time < retryDelay) return;
            // Never reload under someone typing or using a dialog; the next check retries
            const active = document.activeElement;
            if (document.querySelector('dialog[open]') || (active && /^(INPUT|TEXTAREA|SELECT)$/.test(active.tagName))) return;
            sessionStorage.setItem(key, JSON.stringify({ version: data.version, time: Date.now() }));
            const url = new URL(window.location.href);
            url.searchParams.set('_sw_refresh', Date.now().toString());
            try {
              // Serialise the query the same way the reloaded page will, so the paths compare equal
              const clean = new URL(url.href);
              clean.searchParams.delete('_sw_refresh');
              sessionStorage.setItem(
                'tipitaka-refresh-scroll',
                JSON.stringify({ path: clean.pathname + clean.search, y: document.querySelector('.content-pane')?.scrollTop ?? 0 })
              );
            } catch {}
            window.location.replace(url.href);
          } catch (error) {
            console.warn('Unable to check for a site update:', error);
          } finally {
            checking = false;
          }
        }

        window.addEventListener('pageshow', checkForUpdate);
        document.addEventListener('visibilitychange', checkForUpdate);
        window.addEventListener('focus', checkForUpdate);
        window.setInterval(checkForUpdate, checkInterval);
      })();
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts: Noto Sans with complete Pali diacritics and Asian script support -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Brahmi&family=Noto+Sans+Devanagari:wght@400;600;700&family=Noto+Sans+Myanmar:wght@400;600;700&family=Noto+Sans+Sinhala:wght@400;600;700&family=Noto+Sans+Thai:wght@400;600;700&family=Noto+Sans:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Prev / Next Pagination Links -->
    {prevUrl && <link rel="prev" href={prevUrl.startsWith('http') ? prevUrl : `${siteOrigin}${prevUrl}`} />}
    {nextUrl && <link rel="next" href={nextUrl.startsWith('http') ? nextUrl : `${siteOrigin}${nextUrl}`} />}

    <!-- Open Graph -->
    <meta property="og:site_name" content="Tipitaka Editions in Markdown" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'pi' ? 'pi_IN' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={jsonLdString} />

    <!-- PWA & Mobile Web App Meta -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Tipitaka MD" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" sizes="180x180" />
    <link rel="icon" href="/images/logo.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/images/logo24.png" sizes="24x24" type="image/png" />
    <link rel="icon" href="/images/logo48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/images/logo128.png" sizes="128x128" type="image/png" />
    <link rel="icon" href="/images/logo.ico" />
    <meta name="theme-color" content="#b565a7" />
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" class="visually-hidden" aria-hidden="true">
      <symbol id="check2" viewBox="0 0 16 16">
        <path
          fill="currentColor"
          d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"
        ></path>
      </symbol>
      <symbol id="circle-half" viewBox="0 0 16 16">
        <path fill="currentColor" d="M8 15A7 7 0 1 0 8 1v14zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16z"></path>
      </symbol>
      <symbol id="moon-stars-fill" viewBox="0 0 16 16">
        <path
          fill="currentColor"
          d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"
        ></path>
        <path
          fill="currentColor"
          d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.734 1.734 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.734 1.734 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.734 1.734 0 0 0 1.097-1.097l.387-1.162zM13.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.156 1.156 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.156 1.156 0 0 0-.732-.732l-.774-.258a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732L13.863.1z"
        ></path>
      </symbol>
      <symbol id="sun-fill" viewBox="0 0 16 16">
        <path
          fill="currentColor"
          d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"
        ></path>
      </symbol>
    </svg>

    <div class="floating-tools-widget">
      <!-- Dictionary Toggle Button -->
      <button
        type="button"
        id="dict-hover-toggle-btn"
        class="dict-hover-toggle-btn active"
        aria-label="Toggle Dictionary Lookup"
        aria-pressed="true"
        title="Dictionary Lookup: ON (Click to toggle)"
      >
        <span class="dict-toggle-icon" aria-hidden="true">📖</span>
        <span class="dict-toggle-label">Dict</span>
      </button>

      <!-- Theme Switcher -->
      <div class="theme-toggle-widget">
        <details class="theme-toggle-details" id="theme-details">
          <summary class="theme-toggle-btn" aria-label="Toggle color scheme">
            <svg width="16" height="16" aria-hidden="true">
              <use href="#circle-half" id="active-theme-icon"></use>
            </svg>
            <span class="visually-hidden">Toggle theme</span>
          </summary>
          <ul class="theme-menu" aria-label="Color scheme options">
            <li>
              <button type="button" class="theme-option" data-scheme-value="light" aria-pressed="false">
                <svg class="theme-icon" width="16" height="16" aria-hidden="true">
                  <use href="#sun-fill"></use>
                </svg>
                Light
                <svg class="check-icon" width="16" height="16" aria-hidden="true">
                  <use href="#check2"></use>
                </svg>
              </button>
            </li>
            <li>
              <button type="button" class="theme-option" data-scheme-value="dark" aria-pressed="false">
                <svg class="theme-icon" width="16" height="16" aria-hidden="true">
                  <use href="#moon-stars-fill"></use>
                </svg>
                Dark
                <svg class="check-icon" width="16" height="16" aria-hidden="true">
                  <use href="#check2"></use>
                </svg>
              </button>
            </li>
            <li>
              <button type="button" class="theme-option" data-scheme-value="light dark" aria-pressed="true">
                <svg class="theme-icon" width="16" height="16" aria-hidden="true">
                  <use href="#circle-half"></use>
                </svg>
                Auto
                <svg class="check-icon" width="16" height="16" aria-hidden="true">
                  <use href="#check2"></use>
                </svg>
              </button>
            </li>
          </ul>
        </details>
      </div>
    </div>

    <div class="app-shell">
      <input type="checkbox" id="sidebar-drawer-toggle" class="sidebar-drawer-checkbox" aria-hidden="true" />
      <header class="mobile-header">
        <label for="sidebar-drawer-toggle" class="mobile-menu-btn" aria-label="Toggle Tipiṭaka navigation">
          <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"
            ></path>
          </svg>
        </label>
        <a href="/" class="mobile-brand">
          <img src="/images/logo48.png" alt="Tipitaka Editions in Markdown" width="22" height="22" />
          <span>Tipitaka Editions in Markdown</span>
        </a>
      </header>
      <label for="sidebar-drawer-toggle" class="sidebar-backdrop" aria-hidden="true"></label>
      <Sidebar currentBook={currentBook} />
      <div class="content-pane">
        <button
          type="button"
          id="sidebar-show-btn"
          class="sidebar-show-btn"
          aria-label="Show sidebar (Ctrl+B / ⌘B)"
          title="Show sidebar (Ctrl+B / ⌘B)"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="9" y1="3" x2="9" y2="21"></line>
            <path d="m12 9 3 3-3 3"></path>
          </svg>
        </button>
        <div class="content-container">
          <slot />
        </div>
      </div>
    </div>

    <!-- Quick Jump Modal for searching books and suttas -->
    <dialog id="quick-jump-dialog" class="modal-dialog" aria-labelledby="quick-jump-title">
      <div class="modal-header">
        <h2 id="quick-jump-title" class="modal-title">Quick Jump to Paragraph, Book, or Sutta</h2>
        <button type="button" class="modal-close-btn" id="close-quick-jump" aria-label="Close dialog">
          ✕
        </button>
      </div>
      <div class="modal-body">
        <label for="quick-jump-input" class="form-label">
          Search by PTS reference (e.g. <code>M I 1</code>, <code>D II 150</code>, <code>Vin III 1</code>, <code>Dhp 40</code>), WT paragraph (e.g. <code>1V:0001</code>, <code>6D:0001</code>), book code, or title:
        </label>
        <input
          type="search"
          id="quick-jump-input"
          class="form-input"
          placeholder="Type M I 1, D II 150, 1V:0001, Dhp 40, Brahmajāla, or Mahāvibhaṅga…"
          autocomplete="off"
          spellcheck="false"
        />
        <div id="quick-jump-status" class="visually-hidden" aria-live="polite"></div>
        <div id="quick-jump-results" class="quick-jump-results"></div>
      </div>
    </dialog>

    <!-- Dictionary Hover Popover -->
    <div id="dict-hover-popover" class="dict-hover-popover" role="region" aria-label="Dictionary Lookup" hidden></div>

    <script is:inline>
      // Color Scheme Switcher
      (() => {
        const meta = document.querySelector('meta[name="color-scheme"]');
        const activeIcon = document.getElementById('active-theme-icon');
        const detailsEl = document.getElementById('theme-details');
        const buttons = document.querySelectorAll('[data-scheme-value]');
        const iconMap = {
          light: '#sun-fill',
          dark: '#moon-stars-fill',
          'light dark': '#circle-half',
        };

        function syncUI(scheme) {
          if (meta) meta.content = scheme;
          if (activeIcon) activeIcon.setAttribute('href', iconMap[scheme] || '#circle-half');
          buttons.forEach((btn) => {
            const isSelected = btn.getAttribute('data-scheme-value') === scheme;
            btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
          });
        }

        let currentScheme = 'light dark';
        try {
          currentScheme = localStorage.getItem('color-scheme') ?? 'light dark';
        } catch {}
        syncUI(currentScheme);

        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const chosen = btn.getAttribute('data-scheme-value') || 'light dark';
            try {
              // An explicit Light/Dark is kept even when it matches the OS today,
              // so it survives the OS scheme changing later.
              if (chosen === 'light dark') {
                localStorage.removeItem('color-scheme');
              } else {
                localStorage.setItem('color-scheme', chosen);
              }
            } catch {}
            syncUI(chosen);
            if (detailsEl) detailsEl.removeAttribute('open');
          });
        });

        document.addEventListener('click', (e) => {
          if (detailsEl && detailsEl.hasAttribute('open') && !detailsEl.contains(e.target)) {
            detailsEl.removeAttribute('open');
          }
        });
      })();

      // Quick Jump Search System across Tipiṭaka books and suttas
      (() => {
        const dialog = document.getElementById('quick-jump-dialog');
        const openBtn = document.getElementById('open-quick-jump');
        const closeBtn = document.getElementById('close-quick-jump');
        const input = document.getElementById('quick-jump-input');
        const resultsEl = document.getElementById('quick-jump-results');
        const statusEl = document.getElementById('quick-jump-status');

        let catalogData = null;
        async function ensureCatalogData() {
          if (catalogData) return catalogData;
          try {
            const res = await fetch('/catalog.json', { cache: 'no-store' });
            catalogData = await res.json();
          } catch {
            catalogData = { structure: [] };
          }
          return catalogData;
        }

        let wtkParagraphs = null;
        async function ensureWtkParagraphs() {
          if (wtkParagraphs) return wtkParagraphs;
          try {
            const res = await fetch('/wtk_paragraphs.json', { cache: 'no-store' });
            wtkParagraphs = await res.json();
          } catch {
            wtkParagraphs = {};
          }
          return wtkParagraphs;
        }

        let ptsReferences = null;
        async function ensurePtsReferences() {
          if (ptsReferences) return ptsReferences;
          try {
            const res = await fetch('/pts_references.json', { cache: 'no-store' });
            ptsReferences = await res.json();
          } catch {
            ptsReferences = { volumes: {}, aliases: {}, volume_titles: {} };
          }
          return ptsReferences;
        }

        const ROMAN_TO_INT = {
          i: 1, ii: 2, iii: 3, iv: 4, v: 5,
          vi: 6, vii: 7, viii: 8, ix: 9, x: 10,
          xi: 11, xii: 12
        };

        function parsePtsCitation(rawQuery, ptsData) {
          if (!rawQuery || !ptsData || !ptsData.volumes) return null;
          const q = rawQuery.trim().replace(/^PTS\s+/i, '');

          // 1. Two-level citation: <Book> [sep] <Vol> [sep] <Page>
          // e.g. "M I 1", "M.i.1", "M 1.1", "M 1 1", "Vin III 1", "D II 150", "Ja 1 10"
          let match = q.match(/^([a-zA-Z\u0100-\u017F\u1E00-\u1EFF]+)\s*[:.\s,-]\s*([ivxIVX]+|\d+)\s*[:.\s,-]\s*(\d+)$/i);
          if (match) {
            const bookRaw = match[1].toUpperCase();
            const volRaw = match[2].toLowerCase();
            const pageNum = parseInt(match[3], 10);
            const volNum = ROMAN_TO_INT[volRaw] || parseInt(volRaw, 10);
            const canonicalBook = ptsData.aliases[bookRaw] || ptsData.aliases[stripDiacritics(bookRaw).toUpperCase()];
            if (canonicalBook && volNum) {
              const volKey = `${canonicalBook} ${volNum}`;
              if (ptsData.volumes[volKey]) {
                return { volKey, pageNum, originalQuery: rawQuery };
              }
            }
          }

          // 2. Single-level citation: <Book> [sep] <Page>
          // e.g. "Dhp 40", "Dhp.40", "Ud 15", "Sn 50", "Vism 120", "Mil 25"
          match = q.match(/^([a-zA-Z\u0100-\u017F\u1E00-\u1EFF]+)\s*[:.\s,-]\s*(\d+)$/i);
          if (match) {
            let bookRaw = match[1].toUpperCase();
            if (bookRaw === 'SN') bookRaw = 'SNP';
            const pageNum = parseInt(match[2], 10);
            const canonicalBook = ptsData.aliases[bookRaw] || ptsData.aliases[stripDiacritics(bookRaw).toUpperCase()];
            if (canonicalBook && ptsData.volumes[canonicalBook]) {
              return { volKey: canonicalBook, pageNum, originalQuery: rawQuery };
            }
          }
          return null;
        }

        function stripDiacritics(str) {
          return (str || '')
            .normalize('NFKD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase();
        }

        async function renderQuickJump(rawQuery) {
          const q = (rawQuery || '').trim();
          const qNorm = stripDiacritics(q);
          const htmlParts = [];
          let wtkMatchCount = 0;

          // Check for PTS reference match (e.g. "M I 1", "M.i.1", "D II 150", "Vin III 1", "Dhp 40")
          const isPtsCandidate = /^(?:PTS\s+)?[a-zA-Z\u0100-\u017F\u1E00-\u1EFF]+\s*[:.\s,-]\s*(?:[ivxIVX]+|\d+)/i.test(q);
          if (isPtsCandidate) {
            const ptsData = await ensurePtsReferences();
            const ptsMatch = parsePtsCitation(q, ptsData);
            if (ptsMatch) {
              const { volKey, pageNum } = ptsMatch;
              const sections = ptsData.volumes[volKey] || [];
              const foundSec = sections.find(([start, end]) => pageNum >= start && pageNum <= end);
              if (foundSec) {
                const [start, end, filePath, title, bookCode] = foundSec;
                const paddedPage = String(pageNum).padStart(3, '0');
                const volTitle = (ptsData.volume_titles && ptsData.volume_titles[volKey]) || volKey;
                const targetUrl = `/reader.html?edition=pts&book=${encodeURIComponent(bookCode)}&file=${encodeURIComponent(filePath)}#page-${paddedPage}`;
                htmlParts.push(`
                  <div class="quick-jump-group">
                    <div class="quick-jump-group-title">🇬🇧 PTS Reference Match</div>
                    <a href="${targetUrl}" class="quick-jump-item" style="border-left: 3px solid #0284c7;">
                      <div>
                        <strong>PTS ${volKey} : p. ${pageNum}</strong> <span class="badge-code">${volTitle}</span>
                        <div class="quick-jump-sub">${title} (pp. ${start}–${end})</div>
                      </div>
                      <span class="badge-pill" style="background: rgba(2, 132, 199, 0.15); color: #0284c7; border-color: rgba(2, 132, 199, 0.3);">Jump to PTS Page →</span>
                    </a>
                  </div>
                `);
              }
            }
          }

          // Check for WT volume:paragraph citation (e.g. "1V:0001", "1V:41", "6D:0189", "6D:189")
          const wtkMatch = q.match(/^(?:WT\s*|WTK\s*|WTE\s*)?([0-9]{1,2}[A-Za-z0-9]+)\s*[:.]\s*(\d+)$/i);
          if (wtkMatch) {
            const volCode = wtkMatch[1].toUpperCase();
            const parNum = parseInt(wtkMatch[2], 10);
            const wtkData = await ensureWtkParagraphs();
            const matchedKey = Object.keys(wtkData).find((k) => k.toUpperCase() === volCode);
            if (matchedKey && Array.isArray(wtkData[matchedKey])) {
              const sections = wtkData[matchedKey];
              const foundSec = sections.find(([start, end]) => parNum >= start && parNum <= end);
              if (foundSec) {
                const [start, end, filePath, title] = foundSec;
                wtkMatchCount = 1;
                const paddedPar = String(parNum).padStart(4, '0');
                const targetUrl = `/reader.html?edition=tipitaka2500&book=${encodeURIComponent(matchedKey)}&file=${encodeURIComponent(filePath)}#p${parNum}`;
                htmlParts.push(`
                  <div class="quick-jump-group">
                    <div class="quick-jump-group-title">WT Citation Match</div>
                    <a href="${targetUrl}" class="quick-jump-item" style="border-left: 3px solid var(--primary-color);">
                      <div>
                        <strong>WT ${matchedKey}:${paddedPar}</strong> <span class="badge-code">${matchedKey} § ${start}–${end}</span>
                        <div class="quick-jump-sub">${title}</div>
                      </div>
                      <span class="badge-pill">Jump to Paragraph →</span>
                    </a>
                  </div>
                `);
              }
            }
          }

          const data = await ensureCatalogData();
          if (!data || !data.structure) {
            if (htmlParts.length > 0) {
              resultsEl.innerHTML = htmlParts.join('');
            }
            return;
          }

          // Collect all books and suttas
          const allBooks = [];
          const allSuttas = [];
          for (const pitaka of data.structure) {
            for (const book of pitaka.books) {
              allBooks.push({ ...book, pitakaName: pitaka.title });
              if (book.suttas) {
                for (const s of book.suttas) {
                  allSuttas.push({ ...s, bookCode: book.code, bookTitle: book.title });
                }
              }
            }
          }

          // Filter matching books
          const matchingBooks = allBooks.filter((b) => {
            if (!qNorm) return true;
            return (
              stripDiacritics(b.code).includes(qNorm) ||
              stripDiacritics(b.title).includes(qNorm) ||
              stripDiacritics(b.pali_title).includes(qNorm) ||
              stripDiacritics(b.pitakaName).includes(qNorm)
            );
          }).slice(0, qNorm ? 8 : 6);

          // Filter matching suttas
          const matchingSuttas = qNorm
            ? allSuttas.filter((s) => {
                return (
                  stripDiacritics(s.id).includes(qNorm) ||
                  stripDiacritics(s.citation).includes(qNorm) ||
                  stripDiacritics(s.title).includes(qNorm) ||
                  stripDiacritics(s.pali_title).includes(qNorm)
                );
              }).slice(0, 8)
            : [];

          if (matchingBooks.length > 0) {
            htmlParts.push(`
              <div class="quick-jump-group">
                <div class="quick-jump-group-title">${qNorm ? 'Matching Books' : 'Tipiṭaka Books'}</div>
                ${matchingBooks
                  .map(
                    (b) => `
                  <a href="/reader.html?book=${encodeURIComponent(b.code)}" class="quick-jump-item">
                    <div>
                      <strong>${b.title}</strong> <span class="badge-code">${b.code}</span>
                      <div class="quick-jump-sub">${b.pitakaName}</div>
                    </div>
                    <span class="badge-pill">Open Book →</span>
                  </a>
                `
                  )
                  .join('')}
              </div>
            `);
          }

          if (matchingSuttas.length > 0) {
            htmlParts.push(`
              <div class="quick-jump-group">
                <div class="quick-jump-group-title">Matching Suttas &amp; Chapters</div>
                ${matchingSuttas
                  .map(
                    (s) => `
                  <a href="/reader.html?book=${encodeURIComponent(s.bookCode)}&sutta=${encodeURIComponent(s.id)}" class="quick-jump-item">
                    <div>
                      <strong>${s.title}</strong> <span class="badge-code">${s.citation}</span>
                      <div class="quick-jump-sub">${s.bookTitle} (${s.bookCode})</div>
                    </div>
                    <span class="badge-pill">Read Sutta →</span>
                  </a>
                `
                  )
                  .join('')}
              </div>
            `);
          }

          if (q) {
            htmlParts.push(`
              <div class="quick-jump-group">
                <div class="quick-jump-group-title">Pāḷi Word Index (Padabhājanīya)</div>
                <a href="/words.html?q=${encodeURIComponent(q)}" class="quick-jump-item">
                  <div>
                    <strong>Search “${q.replace(/[<>&"]/g, '')}” in Pāḷi Word Index →</strong>
                    <div class="quick-jump-sub">Lookup in 146,693 Pāḷi headwords across the 40-volume Tipiṭaka</div>
                  </div>
                  <span class="badge-pill">Word Index →</span>
                </a>
              </div>
            `);
          }

          if (htmlParts.length === 0) {
            htmlParts.push(`
              <div style="padding: 1rem; color: var(--text-secondary); text-align: center;">
                No matching books or suttas found for “${q.replace(/[<>&"]/g, '')}”.
              </div>
            `);
          }

          resultsEl.innerHTML = htmlParts.join('');
          if (statusEl) {
            statusEl.textContent = `${wtkMatchCount + matchingBooks.length + matchingSuttas.length} results shown.`;
          }
        }

        function openQuickJump(initialValue = '') {
          if (!dialog) return;
          dialog.showModal();
          if (input) {
            if (initialValue) input.value = initialValue;
            input.focus();
            input.select();
            renderQuickJump(input.value);
          }
        }

        if (openBtn) {
          openBtn.addEventListener('click', () => openQuickJump());
        }
        if (closeBtn && dialog) {
          closeBtn.addEventListener('click', () => dialog.close());
        }
        if (dialog) {
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog) dialog.close();
          });
        }
        if (input) {
          input.addEventListener('input', () => renderQuickJump(input.value));
          input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              const firstLink = resultsEl.querySelector('a.quick-jump-item');
              if (firstLink) {
                window.location.href = firstLink.getAttribute('href');
                dialog.close();
              }
            }
          });
        }

        // Global keyboard shortcuts (Cmd/Ctrl+K or '/' for Quick Jump)
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            openQuickJump();
            return;
          }
          const tag = (e.target && e.target.tagName) || '';
          const isEditing =
            tag === 'INPUT' ||
            tag === 'TEXTAREA' ||
            tag === 'SELECT' ||
            (e.target && e.target.isContentEditable);
          if (!isEditing && e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
            e.preventDefault();
            openQuickJump();
          }
        });
      })();

      // --- Sidebar Toggle System (Desktop Collapse / Expand + Mobile Drawer) ---
      (() => {
        const collapseBtn = document.getElementById('sidebar-collapse-btn');
        const showBtn = document.getElementById('sidebar-show-btn');
        const drawerToggle = document.getElementById('sidebar-drawer-toggle');

        function toggleSidebar(force) {
          const isMobile = window.innerWidth <= 768;
          if (isMobile) {
            if (drawerToggle) {
              drawerToggle.checked = typeof force === 'boolean' ? force : !drawerToggle.checked;
            }
            return;
          }

          const willCollapse = typeof force === 'boolean'
            ? force
            : !document.documentElement.classList.contains('sidebar-collapsed');

          if (willCollapse) {
            document.documentElement.classList.add('sidebar-collapsed');
            try { localStorage.setItem('tipitaka-sidebar-collapsed', 'true'); } catch {}
          } else {
            document.documentElement.classList.remove('sidebar-collapsed');
            try { localStorage.setItem('tipitaka-sidebar-collapsed', 'false'); } catch {}
          }
        }

        if (collapseBtn) {
          collapseBtn.addEventListener('click', () => {
            if (window.innerWidth <= 768) {
              if (drawerToggle) drawerToggle.checked = false;
            } else {
              toggleSidebar(true);
            }
          });
        }

        if (showBtn) {
          showBtn.addEventListener('click', () => {
            toggleSidebar(false);
          });
        }

        // Global keyboard shortcut: Ctrl+B or Cmd+B to toggle sidebar
        document.addEventListener('keydown', (e) => {
          const tag = (e.target && e.target.tagName) || '';
          const isEditing =
            tag === 'INPUT' ||
            tag === 'TEXTAREA' ||
            tag === 'SELECT' ||
            (e.target && e.target.isContentEditable);
          if (isEditing) return;

          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'b') {
            e.preventDefault();
            toggleSidebar();
          }
        });
      })();

      // --- Pali Grammar Dictionary Hover & Tap Lookup System ---
      (() => {
        const toggleBtn = document.getElementById('dict-hover-toggle-btn');
        const dictPopover = document.getElementById('dict-hover-popover');

        let dictEnabled = true;
        try {
          const saved = localStorage.getItem('tipitaka_dict_hover');
          if (saved !== null) dictEnabled = saved === 'true';
        } catch {}

        const sidebarToggleBtn = document.getElementById('dict-toggle-sidebar');
        const sidebarStatus = document.getElementById('sidebar-dict-status');

        function updateToggleUI(enabled) {
          if (sidebarToggleBtn) {
            sidebarToggleBtn.classList.toggle('active', enabled);
            sidebarToggleBtn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
          }
          if (sidebarStatus) sidebarStatus.textContent = enabled ? 'ON' : 'OFF';
          if (toggleBtn) {
            toggleBtn.classList.toggle('active', enabled);
            toggleBtn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
            toggleBtn.title = `Dictionary Lookup: ${enabled ? 'ON' : 'OFF'} (Click to toggle)`;
          }
        }

        function setDictEnabled(enabled) {
          dictEnabled = enabled;
          try {
            localStorage.setItem('tipitaka_dict_hover', String(enabled));
          } catch {}
          updateToggleUI(enabled);
          if (!enabled && dictPopover) {
            hideDictPopover();
          }
        }

        if (toggleBtn) {
          toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            setDictEnabled(!dictEnabled);
          });
        }

        if (sidebarToggleBtn) {
          sidebarToggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            setDictEnabled(!dictEnabled);
          });
        }

        updateToggleUI(dictEnabled);
        if (!dictPopover) return;

        // Notation symbols from user's Pali Grammar Textbook
        const TO_SYMBOL = {
          nom: '①', acc: '②', instr: '③', dat: '④', abl: '⑤', gen: '⑥', loc: '⑦', voc: '⓪',
          masc: '🚹', fem: '🚺', nt: '🚻', x: '⚧️', sg: '⨀', pl: '⨂', dual: '⨁',
          act: '🟢', reflx: '🔵', pr: '▶️', fut: '⏭', aor: '⏮', opt: '⏯', imp: '⏹',
          cond: '🔀', imperf: '↩️', perf: '🔄', '1st': '👆', '2nd': '🤘', '3rd': '🤟'
        };

        const TO_MEANING = {
          nom: 'subject', acc: 'object', instr: 'by/with', dat: 'for',
          abl: 'from', gen: 'of', loc: 'in/at/on', voc: 'vocative'
        };

        function getSymbols(grammar) {
          if (grammar === 'in comps') return '🆎';
          return grammar.split(' ').map((s) => TO_SYMBOL[s] || s).join('');
        }

        function getCaseUsage(grammar) {
          return grammar.split(' ').map((p) => TO_MEANING[p] || '').join('');
        }

        function escapeHtml(str) {
          if (!str) return '';
          return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
        }

        // Sharded dictionary cache and manifest
        let manifest = null;
        let manifestPromise = null;
        const shardCache = new Map();

        async function loadManifest() {
          if (manifest) return manifest;
          if (!manifestPromise) {
            manifestPromise = fetch('/data/dpd/manifest.json', { cache: 'no-store' })
              .then((res) => {
                if (!res.ok) throw new Error('Local manifest not found');
                return res.json();
              })
              .catch(() => {
                return fetch('https://tipitaka2500.github.io/data/dpd/manifest.json', {
                  cache: 'no-store',
                })
                  .then((res) => {
                    if (!res.ok) throw new Error('Remote manifest not found');
                    return res.json();
                  });
              })
              .then((data) => {
                manifest = data;
                return data;
              })
              .catch((err) => {
                manifestPromise = null;
                console.warn('Could not load Pali grammar dictionary manifest', err);
                return null;
              });
          }
          return manifestPromise;
        }

        function findShardFile(word, m) {
          const boundaries = m.boundaries;
          let low = 0;
          let high = boundaries.length - 1;
          let ans = 0;
          while (low <= high) {
            const mid = (low + high) >> 1;
            if (boundaries[mid] <= word) {
              ans = mid;
              low = mid + 1;
            } else {
              high = mid - 1;
            }
          }
          return m.files[ans];
        }

        async function loadShard(fileId) {
          if (shardCache.has(fileId)) return shardCache.get(fileId);
          try {
            let res = await fetch(`/data/dpd/${fileId}.json`, { cache: 'no-store' });
            if (!res.ok) {
              res = await fetch(`https://tipitaka2500.github.io/data/dpd/${fileId}.json`, {
                cache: 'no-store',
              });
            }
            if (!res.ok) return null;
            const data = await res.json();
            shardCache.set(fileId, data);
            return data;
          } catch {
            return null;
          }
        }

        function normalizePali(raw) {
          if (!raw) return '';
          return raw
            .toLowerCase()
            .replace(/ṁ/g, 'ṃ') // WT writes niggahīta as ṁ; the dictionary is keyed on ṃ
            .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()'"?।॥0-9—–«»\[\]{}]/g, '')
            .trim();
        }

        function generateCandidates(word) {
          const c = [word];
          let k = word;
          if (k.endsWith('ṃ')) {
            c.push(k.slice(0, -1) + 'm');
            c.push(k.slice(0, -1));
          }
          if (k.endsWith('ti')) {
            c.push(k.slice(0, -2));
            c.push(k.slice(0, -2) + 'ṃ');
          }
          if (k.endsWith('pi')) {
            c.push(k.slice(0, -2));
            c.push(k.slice(0, -2) + 'ṃ');
          }
          if (k.endsWith('ñca')) c.push(k.slice(0, -3) + 'ṃ');
          if (k.endsWith('ca')) c.push(k.slice(0, -2), k.slice(0, -2) + 'ṃ');
          if (k.endsWith('ñceva')) c.push(k.slice(0, -5) + 'ṃ');
          if (k.endsWith('eva')) c.push(k.slice(0, -3), k.slice(0, -3) + 'ṃ');
          if (k.endsWith('va')) c.push(k.slice(0, -2));
          if (k.endsWith('n') || k.endsWith('m')) c.push(k.slice(0, -1) + 'ṃ');
          return c;
        }

        async function lookupPaliWord(raw) {
          const norm = normalizePali(raw);
          if (!norm) return null;
          const m = await loadManifest();
          if (!m) return null;

          // 1. Direct match
          const fId = findShardFile(norm, m);
          let shard = await loadShard(fId);
          if (shard && shard[norm]) {
            return { word: norm, entry: shard[norm], variant: null };
          }

          // 2. Candidate variations (sandhi, enclitics, anusvara)
          const cand = generateCandidates(norm);
          for (const alt of cand) {
            if (alt === norm) continue;
            const altFId = findShardFile(alt, m);
            const altShard = altFId === fId ? shard : await loadShard(altFId);
            if (altShard && altShard[alt]) {
              return { word: alt, entry: altShard[alt], variant: norm };
            }
          }
          return null;
        }

        function renderGrammarRow(pos, grammar, word) {
          const sym = getSymbols(grammar);
          const usage = getCaseUsage(grammar);
          return `
            <tr>
              <td>${escapeHtml(pos)}</td>
              <td>${escapeHtml(grammar)}</td>
              <td class="symbol-col">${sym}</td>
              <td class="badge-col"><span class="table-badge badge-grammar">${sym || escapeHtml(pos)}</span></td>
              <td class="usage-col">${escapeHtml(usage)}</td>
              <td>${escapeHtml(word)}</td>
            </tr>
          `;
        }

        let lookupHistory = [];

        function renderPopoverHtml(res, rawWord) {
          let hws = [];
          let grammarList = [];
          let deconstructions = [];

          if (Array.isArray(res.entry)) {
            if (res.entry.length > 0 && typeof res.entry[0] === 'string') {
              deconstructions = res.entry;
            } else {
              hws = res.entry[0] || [];
              grammarList = res.entry[1] || [];
              deconstructions = res.entry[2] || [];
            }
          }

          let headwordsHtml = '';
          if (hws && hws.length > 0) {
            headwordsHtml = `<ol class="dict-headwords">${hws
              .map((h) => {
                const l1 = h[0] ? `<i>${escapeHtml(h[0])}</i>` : '';
                const l2 = h[1] ? ` (<i>${escapeHtml(h[1])}</i>)` : '';
                const constr = h[2]
                  ? ` <span class="dict-construction">[${escapeHtml(h[2])}]</span>`
                  : '';
                const meaning = h[3]
                  ? `: <span class="dict-meaning">${h[3]}</span>`
                  : '';
                return `<li>${l1}${l2}${constr}${meaning}</li>`;
              })
              .join('')}</ol>`;
          }

          let grammarTableHtml = '';
          if (grammarList && grammarList.length > 0) {
            grammarTableHtml = `
              <div class="dict-grammar-wrap">
                <table class="dict-grammar-table">
                  <thead>
                    <tr>
                      <th id="col1">pos</th>
                      <th id="col2">grammar</th>
                      <th id="col3">sym</th>
                      <th id="col4">tag</th>
                      <th id="col5">usage</th>
                      <th id="col6">word</th>
                    </tr>
                  </thead>
                  <tbody>
                    ${grammarList.map((g) => renderGrammarRow(g[0], g[1], g[2])).join('')}
                  </tbody>
                </table>
              </div>
            `;
          }

          let deconstructionHtml = '';
          if (deconstructions && deconstructions.length > 0) {
            const splitLines = deconstructions.map((splitStr) => {
              const parts = splitStr.split(' + ').map((s) => s.trim()).filter(Boolean);
              const pills = parts.map((p) => `<button type="button" class="dict-split-pill" data-lookup="${escapeHtml(p)}" title="Look up ${escapeHtml(p)}">${escapeHtml(p)}</button>`).join(' <span class="dict-split-plus">+</span> ');
              return `<div class="dict-split-line">${pills}</div>`;
            }).join('');

            const isPureDecon = hws.length === 0 && grammarList.length === 0;
            const summaryPlaceholder = isPureDecon ? '<div class="dict-parts-summary" id="dict-parts-summary"><em>Loading component meanings…</em></div>' : '';

            deconstructionHtml = `
              <div class="dict-decon-wrap">
                <div class="dict-decon-title">🧩 Compound / Sandhi Deconstruction</div>
                <div class="dict-splits">${splitLines}</div>
                ${summaryPlaceholder}
              </div>
            `;
          }

          const variantNote = res.variant
            ? `<span class="dict-match-note">(from <em>${escapeHtml(rawWord)}</em>)</span>`
            : '';

          const backBtn = lookupHistory.length > 0
            ? `<button type="button" class="dict-back-btn" data-dict-back="true" title="Go back to ${escapeHtml(lookupHistory[lookupHistory.length - 1])}">← ${escapeHtml(lookupHistory[lookupHistory.length - 1])}</button>`
            : '';

          return `
            <div class="dict-popover-header">
              <div class="dict-popover-title">
                ${backBtn}
                <span class="dict-word">${escapeHtml(res.word)}</span>
                ${variantNote}
              </div>
              <div class="dict-popover-tools">
                <button type="button" class="dict-popover-close" aria-label="Close">✕</button>
              </div>
            </div>
            <div class="dict-popover-body">
              ${deconstructionHtml}
              ${headwordsHtml}
              ${grammarTableHtml}
            </div>
          `;
        }

        async function populateConstituentSummary(res) {
          let deconstructions = [];
          if (Array.isArray(res.entry)) {
            if (res.entry.length > 0 && typeof res.entry[0] === 'string') {
              deconstructions = res.entry;
            } else if (res.entry[2]) {
              deconstructions = res.entry[2];
            }
          }
          if (!deconstructions || deconstructions.length === 0) return;

          const summaryEl = dictPopover.querySelector('#dict-parts-summary');
          if (!summaryEl) return;

          const primarySplit = deconstructions[0];
          const parts = primarySplit.split(' + ').map((s) => s.trim()).filter(Boolean);
          if (parts.length === 0) return;

          try {
            const results = await Promise.all(parts.slice(0, 4).map((p) => lookupPaliWord(p)));
            if (!dictPopover || dictPopover.hidden || !dictPopover.contains(summaryEl)) return;

            const items = results.map((pr, idx) => {
              const partName = parts[idx];
              if (!pr) {
                return `<div class="dict-part-item"><strong>${escapeHtml(partName)}</strong>: <span class="dict-construction">[unindexed]</span></div>`;
              }
              let pHws = [];
              let pGram = [];
              if (Array.isArray(pr.entry) && Array.isArray(pr.entry[0])) {
                pHws = pr.entry[0];
                pGram = pr.entry[1] || [];
              }
              const firstMeaning = (pHws[0] && pHws[0][3]) || (pGram[0] && pGram[0][0]) || '';
              return `<div class="dict-part-item"><strong>${escapeHtml(partName)}</strong>: ${firstMeaning ? `<span class="dict-meaning">${firstMeaning}</span>` : '<em>indexed</em>'}</div>`;
            });

            summaryEl.innerHTML = items.join('');
          } catch {}
        }

        function positionPopover(rect) {
          dictPopover.hidden = false;
          const popRect = dictPopover.getBoundingClientRect();
          let top = rect.bottom + 6;
          let left = rect.left;

          if (left + popRect.width > window.innerWidth - 12) {
            left = Math.max(12, window.innerWidth - popRect.width - 12);
          }
          if (top + popRect.height > window.innerHeight - 12) {
            top = Math.max(12, rect.top - popRect.height - 6);
          }

          dictPopover.style.top = `${top}px`;
          dictPopover.style.left = `${left}px`;
        }

        function hideDictPopover() {
          if (dictPopover) {
            dictPopover.hidden = true;
          }
          lookupHistory = [];
          const oldMark = document.querySelector('mark.dict-hover-highlight');
          if (oldMark) {
            const parent = oldMark.parentNode;
            while (oldMark.firstChild) parent.insertBefore(oldMark.firstChild, oldMark);
            parent.removeChild(oldMark);
            parent.normalize();
          }
        }

        function highlightWordRange(range) {
          const oldMark = document.querySelector('mark.dict-hover-highlight');
          if (oldMark) {
            const parent = oldMark.parentNode;
            while (oldMark.firstChild) parent.insertBefore(oldMark.firstChild, oldMark);
            parent.removeChild(oldMark);
            parent.normalize();
          }
          if (!range) return;
          try {
            const mark = document.createElement('mark');
            mark.className = 'dict-hover-highlight';
            range.surroundContents(mark);
          } catch {}
        }

        function getWordAtPoint(x, y) {
          let range = null;
          let textNode = null;
          let offset = 0;

          if (document.caretRangeFromPoint) {
            range = document.caretRangeFromPoint(x, y);
            if (range) {
              textNode = range.startContainer;
              offset = range.startOffset;
            }
          } else if (document.caretPositionFromPoint) {
            const pos = document.caretPositionFromPoint(x, y);
            if (pos) {
              textNode = pos.offsetNode;
              offset = pos.offset;
            }
          }

          if (!textNode || textNode.nodeType !== Node.TEXT_NODE) return null;

          const text = textNode.nodeValue || '';
          if (!text.trim()) return null;

          const isPaliChar = (ch) => /[A-Za-zāīūñṅṇṭḍḷṃṁĀĪŪÑṄṆṬḌḶṂṀ]/.test(ch);

          let start = offset;
          let end = offset;

          while (start > 0 && isPaliChar(text[start - 1])) start--;
          while (end < text.length && isPaliChar(text[end])) end++;

          if (start === end) return null;
          const word = text.slice(start, end);
          if (word.length < 2) return null;

          const wordRange = document.createRange();
          wordRange.setStart(textNode, start);
          wordRange.setEnd(textNode, end);

          return { word, range: wordRange };
        }

        let hoverTimer = null;
        let leaveTimer = null;
        let currentRawWord = '';
        let dismissedWord = '';
        let dismissedUntil = 0;

        dictPopover.addEventListener('mouseenter', () => {
          if (leaveTimer) {
            clearTimeout(leaveTimer);
            leaveTimer = null;
          }
        });

        dictPopover.addEventListener('mouseleave', () => {
          leaveTimer = setTimeout(() => {
            hideDictPopover();
          }, 300);
        });

        dictPopover.addEventListener('click', async (e) => {
          const closeBtn = e.target.closest('.dict-popover-close');
          if (closeBtn) {
            dismissedWord = currentRawWord;
            dismissedUntil = Date.now() + 1500;
            hideDictPopover();
            return;
          }

          const pill = e.target.closest('.dict-split-pill');
          if (pill) {
            e.preventDefault();
            e.stopPropagation();
            const targetWord = pill.getAttribute('data-lookup');
            if (targetWord) {
              lookupHistory.push(currentRawWord);
              const subRes = await lookupPaliWord(targetWord);
              if (subRes) {
                currentRawWord = targetWord;
                dictPopover.innerHTML = renderPopoverHtml(subRes, targetWord);
                populateConstituentSummary(subRes);
              }
            }
            return;
          }

          const backBtn = e.target.closest('[data-dict-back]');
          if (backBtn && lookupHistory.length > 0) {
            e.preventDefault();
            e.stopPropagation();
            const prevWord = lookupHistory.pop();
            const subRes = await lookupPaliWord(prevWord);
            if (subRes) {
              currentRawWord = prevWord;
              dictPopover.innerHTML = renderPopoverHtml(subRes, prevWord);
              populateConstituentSummary(subRes);
            }
            return;
          }
        });

        // Hover & tap events attached to document body inside content areas
        document.addEventListener('mousemove', (e) => {
          if (!dictEnabled) return;

          const inContent = e.target.closest('.tipitaka-article, .content-pane, main');
          if (!inContent) {
            if (!dictPopover.hidden && !dictPopover.contains(e.target) && !leaveTimer) {
              leaveTimer = setTimeout(() => {
                hideDictPopover();
              }, 200);
            }
            return;
          }

          if (!dictPopover.hidden && dictPopover.contains(e.target)) return;

          if (e.target.closest('a, button, select, input, .reader-toolbar, .dict-hover-popover')) {
            if (hoverTimer) clearTimeout(hoverTimer);
            if (!dictPopover.hidden && !leaveTimer) {
              leaveTimer = setTimeout(() => {
                hideDictPopover();
              }, 120);
            }
            return;
          }

          if (hoverTimer) clearTimeout(hoverTimer);
          if (leaveTimer) {
            clearTimeout(leaveTimer);
            leaveTimer = null;
          }

          hoverTimer = setTimeout(async () => {
            if (Date.now() < dismissedUntil) return;
            const match = getWordAtPoint(e.clientX, e.clientY);
            if (!match) {
              leaveTimer = setTimeout(() => {
                hideDictPopover();
              }, 250);
              return;
            }

            const { word, range } = match;
            if (word === dismissedWord) return;
            dismissedWord = '';

            if (word === currentRawWord && !dictPopover.hidden) return;

            const res = await lookupPaliWord(word);
            if (!res) {
              leaveTimer = setTimeout(() => {
                hideDictPopover();
              }, 200);
              return;
            }

            lookupHistory = [];
            currentRawWord = word;
            highlightWordRange(range);

            dictPopover.innerHTML = renderPopoverHtml(res, word);
            populateConstituentSummary(res);
            positionPopover(range.getBoundingClientRect());
          }, 120);
        });

        document.addEventListener('click', async (e) => {
          if (!dictEnabled) return;
          if (Date.now() < dismissedUntil) return;
          if (e.target.closest('a, button, select, input, .reader-toolbar, .dict-hover-popover'))
            return;

          const inContent = e.target.closest('.tipitaka-article, .content-pane, main');
          if (!inContent) return;

          const match = getWordAtPoint(e.clientX, e.clientY);
          if (!match) return;

          const { word, range } = match;
          if (word === dismissedWord) {
            dismissedWord = '';
            return;
          }

          const res = await lookupPaliWord(word);
          if (!res) return;

          lookupHistory = [];
          currentRawWord = word;
          highlightWordRange(range);

          dictPopover.innerHTML = renderPopoverHtml(res, word);
          populateConstituentSummary(res);
          positionPopover(range.getBoundingClientRect());
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !dictPopover.hidden) {
            dismissedWord = currentRawWord;
            dismissedUntil = Date.now() + 1000;
            hideDictPopover();
          }
        });

        document.addEventListener('click', (e) => {
          if (
            !dictPopover.hidden &&
            !dictPopover.contains(e.target) &&
            !e.target.closest('.dict-hover-toggle-btn')
          ) {
            dismissedWord = currentRawWord;
            dismissedUntil = Date.now() + 400;
            hideDictPopover();
          }
        });
      })();
    </script>
  </body>
</html>
